6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-pseudo"><span>PROCEDURE OllivierRicciCurvature(G) -&gt; ORC_vector_over_edges
    # Approximate ORC via neighborhood measures and W1
    ORC = dict()
    precompute shortest_path_distances d_G(u,v) on the 1-hop induced subgraph per edge
    FOR each edge e=(u,v):
        m_u = NeighborhoodMeasure(u)   # e.g., normalize neighbor weights
        m_v = NeighborhoodMeasure(v)
        # Compute W1(m_u, m_v): small supports → Hungarian/EMD; else Sinkhorn ε-OT
        W1 = Wasserstein1(m_u, m_v, ground_distance=d_G_restricted_to_neighbors(u,v))
        ORC[e] = 1 - W1 / d_G(u,v)     # d_G(u,v)=1 for adjacent; keep general for robustness
    END FOR
    RETURN vectorize_in_fixed_edge_order(ORC)
