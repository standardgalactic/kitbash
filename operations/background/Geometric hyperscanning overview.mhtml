L</span><span><span class="hljs-built_in">^</span></span><span>{-d/2}</span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\le</span></span><span><span class="hljs-keyword">\ </span></span><span>J</span><span><span class="hljs-built_in">_</span></span><span>F(x)</span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\le</span></span><span><span class="hljs-keyword">\ </span></span><span>L</span><span><span class="hljs-built_in">^</span></span><span>{d/2}.
