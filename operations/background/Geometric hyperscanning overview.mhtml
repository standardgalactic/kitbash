</span><span><span class="hljs-built_in">&amp;</span></span><span><span class="hljs-keyword">\textbf</span></span><span>{for } s </span><span><span class="hljs-keyword">\in</span></span><span> </span><span><span class="hljs-keyword">\{</span></span><span>0, S, 2S, </span><span><span class="hljs-keyword">\dots</span></span><span>, T-</span><span><span class="hljs-keyword">\Delta</span></span><span><span class="hljs-keyword">\}</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{ do}</span><span><span class="hljs-keyword">\\</span></span><span>
