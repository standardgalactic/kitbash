</span><span><span class="hljs-comment"># Negentropic corridor score (heuristic)</span></span><span>
</span><span><span class="hljs-comment"># -----------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">negentropic_corridor_score</span></span><span>(</span><span><span class="hljs-params">G: nx.Graph, frc_vals: np.ndarray, edges: <span class="hljs-type">List</span></span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Any</span></span><span>, </span><span><span class="hljs-type">Any</span></span><span>]], eps: </span><span><span class="hljs-built_in">float</span></span><span> = </span><span><span class="hljs-number">0.05</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
