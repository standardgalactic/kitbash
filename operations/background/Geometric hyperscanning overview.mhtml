    intensity </span><span><span class="hljs-operator">=</span></span><span> entropy_gap </span><span><span class="hljs-operator">*</span></span><span> norm</span><span><span class="hljs-punctuation">(</span></span><span>Delta_g</span><span><span class="hljs-punctuation">)</span></span><span>

    </span><span><span class="hljs-built_in">return</span></span><span> intensity
