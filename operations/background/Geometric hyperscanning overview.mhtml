01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-latex"><span><span><span class="hljs-keyword">\paragraph</span></span><span>{Differential entropy (histogram or simple KDE).}

</span><span><span class="hljs-keyword">\begin</span></span><span>{lstlisting}[language=Python]
def diff</span><span><span class="hljs-built_in">_</span></span><span>entropy(values, method="kde"):
    v = np.asarray(values, float); v = v[np.isfinite(v)]
    if v.size == 0: return np.nan
    if method == "hist":
        </span><span><span class="hljs-params">#</span></span><span> Freedman–Diaconis bins
        iqr = np.subtract(*np.percentile(v, [75,25]))
        bw = 2*iqr*(v.size**(-1/3)) if iqr&gt;0 else np.std(v)*(v.size**(-1/3))
        bins = max(8, int(np.ceil((v.max()-v.min())/(bw+1e-12))))
        hist, edges = np.histogram(v, bins=bins, density=True)
        p = np.maximum(hist, 1e-12)
        H = -np.sum(p*np.log(p))*(edges[1]-edges[0])
        return float(H)
    </span><span><span class="hljs-params">#</span></span><span> Gaussian KDE
    std = np.std(v)
    if std &lt;= 1e-12: return 0.0
    bw = 1.06*std*(v.size**(-1/5))
    grid = np.linspace(v.min()-3*std, v.max()+3*std, 512)
    dens = np.mean(np.exp(-0.5*((grid[:,None]-v[None,:])/bw)**2), axis=1) / (bw*np.sqrt(2*np.pi))
    dens = np.maximum(dens, 1e-12)
    return float(-np.trapz(dens*np.log(dens), grid))
</span><span><span class="hljs-keyword">\end</span></span><span>{lstlisting}
</span></span></code></div></div></pre>
<p data-start="1518" data-end="1602">That will wrap the long <code data-start="1542" data-end="1563">dens = np.mean(...)</code> line automatically inside the margins.</p>
<hr data-start="1604" data-end="1607">
