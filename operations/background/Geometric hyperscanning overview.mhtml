</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">wasserstein1_discrete</span></span><span>(</span><span><span class="hljs-params">cost_mat: np.ndarray, p: np.ndarray, q: np.ndarray</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
