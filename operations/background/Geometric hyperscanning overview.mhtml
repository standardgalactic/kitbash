</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">forman_ricci_curvature</span></span><span>(</span><span><span class="hljs-params">G: nx.Graph, node_scheme: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"strength"</span></span><span>) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[np.ndarray, </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Any</span></span><span>, </span><span><span class="hljs-type">Any</span></span><span>]]]:
