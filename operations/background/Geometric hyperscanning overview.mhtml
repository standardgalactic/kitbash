</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">ollivier_ricci_curvature_toy</span></span><span>(</span><span><span class="hljs-params">G: nx.Graph</span></span><span>) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[np.ndarray, </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Any</span></span><span>, </span><span><span class="hljs-type">Any</span></span><span>]]]:
