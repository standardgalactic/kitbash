</span><span><span class="hljs-comment"># -----------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># This notebook scaffold builds a time-varying interbrain graph from</span></span><span>
</span><span><span class="hljs-comment"># two multichannel time series, computes Forman–Ricci curvature (FRC),</span></span><span>
</span><span><span class="hljs-comment"># optionally a toy Ollivier–Ricci (ORC) approximation on small neighborhoods,</span></span><span>
</span><span><span class="hljs-comment"># estimates entropy of curvature distributions, and detects phase transitions.</span></span><span>
</span><span><span class="hljs-comment">#</span></span><span>
</span><span><span class="hljs-comment"># Notes:</span></span><span>
</span><span><span class="hljs-comment"># - Dependencies: numpy, scipy, networkx, matplotlib, sklearn (optional)</span></span><span>
</span><span><span class="hljs-comment"># - Plots: matplotlib only, single chart per figure, no custom colors.</span></span><span>
</span><span><span class="hljs-comment"># - Demo at bottom generates synthetic signals with a regime shift.</span></span><span>
</span><span><span class="hljs-comment">#</span></span><span>
</span><span><span class="hljs-comment"># You can replace the synthetic signals with your own arrays:</span></span><span>
</span><span><span class="hljs-comment">#   signals_A: shape (n_channels_A, T)</span></span><span>
</span><span><span class="hljs-comment">#   signals_B: shape (n_channels_B, T)</span></span><span>
</span><span><span class="hljs-comment"># Sampling rate is used only to convert window sizes in seconds to samples.</span></span><span>


</span><span><span class="hljs-keyword">import</span></span><span> numpy </span><span><span class="hljs-keyword">as</span></span><span> np
</span><span><span class="hljs-keyword">import</span></span><span> networkx </span><span><span class="hljs-keyword">as</span></span><span> nx
</span><span><span class="hljs-keyword">import</span></span><span> math
</span><span><span class="hljs-keyword">from</span></span><span> typing </span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-type">Dict</span></span><span>, </span><span><span class="hljs-type">Any</span></span><span>, </span><span><span class="hljs-type">List</span></span><span>, </span><span><span class="hljs-type">Tuple</span></span><span>
</span><span><span class="hljs-keyword">from</span></span><span> dataclasses </span><span><span class="hljs-keyword">import</span></span><span> dataclass
</span><span><span class="hljs-keyword">import</span></span><span> warnings

</span><span><span class="hljs-comment"># Optional utilities if available</span></span><span>
</span><span><span class="hljs-keyword">try</span></span><span>:
    </span><span><span class="hljs-keyword">from</span></span><span> scipy.signal </span><span><span class="hljs-keyword">import</span></span><span> hilbert, butter, filtfilt, welch, coherence
    </span><span><span class="hljs-keyword">from</span></span><span> scipy.spatial.distance </span><span><span class="hljs-keyword">import</span></span><span> cdist
    </span><span><span class="hljs-keyword">from</span></span><span> scipy.stats </span><span><span class="hljs-keyword">import</span></span><span> entropy </span><span><span class="hljs-keyword">as</span></span><span> scipy_entropy
</span><span><span class="hljs-keyword">except</span></span><span> Exception:
    hilbert = </span><span><span class="hljs-literal">None</span></span><span>
    butter = </span><span><span class="hljs-literal">None</span></span><span>
    filtfilt = </span><span><span class="hljs-literal">None</span></span><span>
    welch = </span><span><span class="hljs-literal">None</span></span><span>
    coherence = </span><span><span class="hljs-literal">None</span></span><span>
    cdist = </span><span><span class="hljs-literal">None</span></span><span>
    scipy_entropy = </span><span><span class="hljs-literal">None</span></span><span>

</span><span><span class="hljs-keyword">import</span></span><span> matplotlib.pyplot </span><span><span class="hljs-keyword">as</span></span><span> plt


</span><span><span class="hljs-comment"># -----------------------------</span></span><span>
</span><span><span class="hljs-comment"># Utility: windowing</span></span><span>
</span><span><span class="hljs-comment"># -----------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">sliding_windows</span></span><span>(</span><span><span class="hljs-params">T: <span class="hljs-built_in">int</span></span></span><span>, win: </span><span><span class="hljs-built_in">int</span></span><span>, step: </span><span><span class="hljs-built_in">int</span></span><span>) -&gt; </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-built_in">int</span></span><span>, </span><span><span class="hljs-built_in">int</span></span><span>]]:
    starts = np.arange(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>, T - win + </span><span><span class="hljs-number">1</span></span><span>), step)
    </span><span><span class="hljs-keyword">return</span></span><span> [(</span><span><span class="hljs-built_in">int</span></span><span>(s), </span><span><span class="hljs-built_in">int</span></span><span>(s + win)) </span><span><span class="hljs-keyword">for</span></span><span> s </span><span><span class="hljs-keyword">in</span></span><span> starts]


</span><span><span class="hljs-comment"># -----------------------------</span></span><span>
</span><span><span class="hljs-comment"># IBS metrics</span></span><span>
</span><span><span class="hljs-comment"># -----------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">plv</span></span><span>(</span><span><span class="hljs-params">x: np.ndarray, y: np.ndarray</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
    <span class="hljs-string">"""
    Phase-Locking Value via analytic signal (Hilbert).
    Assumes x,y are 1D arrays (time) of equal length.
    """</span>
    </span><span><span class="hljs-keyword">if</span></span><span> hilbert </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        </span><span><span class="hljs-comment"># Fallback: simple phase proxy using arctan of normalized signal</span></span><span>
        </span><span><span class="hljs-comment"># (less accurate than Hilbert; provided to avoid hard dependency)</span></span><span>
        px = np.angle(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * np.unwrap(np.angle(np.fft.hilbert(x))))) </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">hasattr</span></span><span>(np.fft, </span><span><span class="hljs-string">'hilbert'</span></span><span>) </span><span><span class="hljs-keyword">else</span></span><span> np.angle(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * x))
        py = np.angle(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * np.unwrap(np.angle(np.fft.hilbert(y))))) </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">hasattr</span></span><span>(np.fft, </span><span><span class="hljs-string">'hilbert'</span></span><span>) </span><span><span class="hljs-keyword">else</span></span><span> np.angle(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * y))
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">float</span></span><span>(np.</span><span><span class="hljs-built_in">abs</span></span><span>(np.mean(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * (px - py)))))
    ax = hilbert(x - np.mean(x))
    ay = hilbert(y - np.mean(y))
    phase_diff = np.angle(ax) - np.angle(ay)
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">float</span></span><span>(np.</span><span><span class="hljs-built_in">abs</span></span><span>(np.mean(np.exp(</span><span><span class="hljs-number">1j</span></span><span> * phase_diff))))


</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">corr_coef</span></span><span>(</span><span><span class="hljs-params">x: np.ndarray, y: np.ndarray</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
    </span><span><span class="hljs-keyword">if</span></span><span> x.std() == </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> y.std() == </span><span><span class="hljs-number">0</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-number">0.0</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">float</span></span><span>(np.corrcoef(x, y)[</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">1</span></span><span>])


</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">ibs_metric_dispatch</span></span><span>(</span><span><span class="hljs-params">x: np.ndarray, y: np.ndarray, metric: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"PLV"</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
    m = metric.lower()
    </span><span><span class="hljs-keyword">if</span></span><span> m == </span><span><span class="hljs-string">"plv"</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> plv(x, y)
    </span><span><span class="hljs-keyword">elif</span></span><span> m </span><span><span class="hljs-keyword">in</span></span><span> (</span><span><span class="hljs-string">"corr"</span></span><span>, </span><span><span class="hljs-string">"correlation"</span></span><span>):
        </span><span><span class="hljs-keyword">return</span></span><span> corr_coef(x, y)
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">raise</span></span><span> ValueError(</span><span><span class="hljs-string">f"Unknown IBS metric: <span class="hljs-subst">{metric}</span></span></span><span>")


</span><span><span class="hljs-comment"># -----------------------------</span></span><span>
</span><span><span class="hljs-comment"># Graph construction</span></span><span>
</span><span><span class="hljs-comment"># -----------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">intra_brain_knn</span></span><span>(</span><span><span class="hljs-params">coords: np.ndarray, k: <span class="hljs-built_in">int</span></span></span><span> = </span><span><span class="hljs-number">4</span></span><span>) -&gt; np.ndarray:
    <span class="hljs-string">"""
    Build k-NN graph (unweighted adjacency) from 2D or 3D coordinates.
    Returns adjacency matrix (0/1).
    """</span>
    </span><span><span class="hljs-keyword">if</span></span><span> coords </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>
    D = cdist(coords, coords) </span><span><span class="hljs-keyword">if</span></span><span> cdist </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">else</span></span><span> np.sqrt(((coords[:, </span><span><span class="hljs-literal">None</span></span><span>, :] - coords[</span><span><span class="hljs-literal">None</span></span><span>, :, :])**</span><span><span class="hljs-number">2</span></span><span>).</span><span><span class="hljs-built_in">sum</span></span><span>(-</span><span><span class="hljs-number">1</span></span><span>))
    np.fill_diagonal(D, np.inf)
    idx = np.argsort(D, axis=</span><span><span class="hljs-number">1</span></span><span>)[:, :k]
    A = np.zeros((coords.shape[</span><span><span class="hljs-number">0</span></span><span>], coords.shape[</span><span><span class="hljs-number">0</span></span><span>]), dtype=</span><span><span class="hljs-built_in">float</span></span><span>)
    rows = np.repeat(np.arange(coords.shape[</span><span><span class="hljs-number">0</span></span><span>]), k)
    A[rows, idx.flatten()] = </span><span><span class="hljs-number">1.0</span></span><span>
    </span><span><span class="hljs-comment"># Symmetrize</span></span><span>
    A = np.maximum(A, A.T)
    </span><span><span class="hljs-keyword">return</span></span><span> A


</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">build_interbrain_graph</span></span><span>(<span class="hljs-params">
    XA: np.ndarray,
    XB: np.ndarray,
    ibs_metric: </span></span><span><span class="hljs-built_in">str</span></span><span> = </span><span><span class="hljs-string">"PLV"</span></span><span>,
    prune_percentile: </span><span><span class="hljs-built_in">float</span></span><span> = </span><span><span class="hljs-number">80.0</span></span><span>,
    A_coords: np.ndarray = </span><span><span class="hljs-literal">None</span></span><span>,
    B_coords: np.ndarray = </span><span><span class="hljs-literal">None</span></span><span>,
    intra_k: </span><span><span class="hljs-built_in">int</span></span><span> = </span><span><span class="hljs-number">3</span></span><span>
) -&gt; nx.Graph:
    <span class="hljs-string">"""
    Build bipartite interbrain graph with optional intra-brain kNN scaffolds.
    XA, XB: (n_channels × W) windowed signals
    """</span>
    nA, nB = XA.shape[</span><span><span class="hljs-number">0</span></span><span>], XB.shape[</span><span><span class="hljs-number">0</span></span><span>]
    </span><span><span class="hljs-comment"># Inter-brain weights</span></span><span>
    W_inter = np.zeros((nA, nB), dtype=</span><span><span class="hljs-built_in">float</span></span><span>)
    </span><span><span class="hljs-keyword">for</span></span><span> i </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(nA):
        </span><span><span class="hljs-keyword">for</span></span><span> j </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(nB):
            W_inter[i, j] = ibs_metric_dispatch(XA[i], XB[j], ibs_metric)

    </span><span><span class="hljs-comment"># Prune weak inter edges</span></span><span>
    tau = np.percentile(W_inter, prune_percentile)
    W_inter = np.where(W_inter &gt;= tau, W_inter, </span><span><span class="hljs-number">0.0</span></span><span>)

    G = nx.Graph()
    </span><span><span class="hljs-comment"># Add nodes with partition labels</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> i </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(nA):
        G.add_node((</span><span><span class="hljs-string">"A"</span></span><span>, i), hemisphere=</span><span><span class="hljs-string">"A"</span></span><span>)
    </span><span><span class="hljs-keyword">for</span></span><span> j </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(nB):
        G.add_node((</span><span><span class="hljs-string">"B"</span></span><span>, j), hemisphere=</span><span><span class="hljs-string">"B"</span></span><span>)

    </span><span><span class="hljs-comment"># Add inter edges</span></span><span>
    inter_edges = np.argwhere(W_inter &gt; </span><span><span class="hljs-number">0</span></span><span>)
    </span><span><span class="hljs-keyword">for</span></span><span> (i, j) </span><span><span class="hljs-keyword">in</span></span><span> inter_edges:
        G.add_edge((</span><span><span class="hljs-string">"A"</span></span><span>, i), (</span><span><span class="hljs-string">"B"</span></span><span>, j), weight=</span><span><span class="hljs-built_in">float</span></span><span>(W_inter[i, j]))

    </span><span><span class="hljs-comment"># Intra-brain scaffolds using kNN on coordinates if given</span></span><span>
