</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">node_weight</span></span><span>(</span><span><span class="hljs-params">G: nx.Graph, node, scheme: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"strength"</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
