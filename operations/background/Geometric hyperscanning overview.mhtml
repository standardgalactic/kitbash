            bins = </span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">5</span></span><span>, </span><span><span class="hljs-built_in">int</span></span><span>(np.ceil((v.</span><span><span class="hljs-built_in">max</span></span><span>() - v.</span><span><span class="hljs-built_in">min</span></span><span>()) / (bw + </span><span><span class="hljs-number">1e-12</span></span><span>))))
