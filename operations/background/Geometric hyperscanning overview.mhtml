.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">import</span></span><span> numpy </span><span><span class="hljs-keyword">as</span></span><span> np
</span><span><span class="hljs-keyword">from</span></span><span> numpy.linalg </span><span><span class="hljs-keyword">import</span></span><span> norm

</span><span><span class="hljs-comment"># Gaussian manifold approximation</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">manifold_points</span></span><span>(</span><span><span class="hljs-params">mean, cov, n=<span class="hljs-number">500</span></span></span><span>):
    </span><span><span class="hljs-keyword">return</span></span><span> np.random.multivariate_normal(mean, cov, n)

</span><span><span class="hljs-comment"># Pullback metric distortion (toy: covariance matrices)</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">distortion</span></span><span>(</span><span><span class="hljs-params">g1, g2</span></span><span>):
    </span><span><span class="hljs-keyword">return</span></span><span> g2 - g1

</span><span><span class="hljs-comment"># Differential entropy estimate (Gaussian approximation)</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">gaussian_entropy</span></span><span>(</span><span><span class="hljs-params">cov</span></span><span>):
    d = cov.shape[</span><span><span class="hljs-number">0</span></span><span>]
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-number">0.5</span></span><span> * np.log(np.linalg.det(</span><span><span class="hljs-number">2</span></span><span> * np.pi * np.e * cov))

</span><span><span class="hljs-comment"># Humor event simulation</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">humor_event</span></span><span>(</span><span><span class="hljs-params">mean1, cov1, mean2, cov2, n=<span class="hljs-number">500</span></span></span><span>):
    </span><span><span class="hljs-comment"># Sample from M1</span></span><span>
    X1 = manifold_points(mean1, cov1, n)
    </span><span><span class="hljs-comment"># Frame shift: translate into M2’s mean</span></span><span>
    X2 = X1 + (mean2 - mean1)
    
    </span><span><span class="hljs-comment"># Distortion = curvature mismatch</span></span><span>
    Δg = distortion(cov1, cov2)
    
    </span><span><span class="hljs-comment"># Entropy gap</span></span><span>
    H1, H2 = gaussian_entropy(cov1), gaussian_entropy(cov2)
    ΔS = H2 - H1
    
    </span><span><span class="hljs-comment"># Humor intensity = entropy release × distortion magnitude</span></span><span>
    intensity = ΔS * norm(Δg)
    </span><span><span class="hljs-keyword">return</span></span><span> intensity, ΔS, norm(Δg)

</span><span><span class="hljs-comment"># Example: two semantic manifolds</span></span><span>
mean1 = np.array([</span><span><span class="hljs-number">0.0</span></span><span>, </span><span><span class="hljs-number">0.0</span></span><span>])
cov1 = np.array([[</span><span><span class="hljs-number">1.0</span></span><span>, </span><span><span class="hljs-number">0.2</span></span><span>],[</span><span><span class="hljs-number">0.2</span></span><span>, </span><span><span class="hljs-number">0.5</span></span><span>]])

mean2 = np.array([</span><span><span class="hljs-number">1.0</span></span><span>, -</span><span><span class="hljs-number">1.0</span></span><span>])
cov2 = np.array([[</span><span><span class="hljs-number">0.8</span></span><span>, </span><span><span class="hljs-number">0.3</span></span><span>],[</span><span><span class="hljs-number">0.3</span></span><span>, </span><span><span class="hljs-number">0.9</span></span><span>]])

intensity, ΔS, normΔg = humor_event(mean1, cov1, mean2, cov2)

</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Entropy gap ΔS = <span class="hljs-subst">{ΔS:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Distortion norm ||Δg|| = <span class="hljs-subst">{normΔg:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Humor intensity = <span class="hljs-subst">{intensity:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span></span></code></div></div></pre>
