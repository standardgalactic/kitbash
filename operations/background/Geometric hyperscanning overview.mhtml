</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">demo_synthetic</span></span><span>(</span><span><span class="hljs-params">Fs=<span class="hljs-number">200.0</span></span></span><span>, T_sec=</span><span><span class="hljs-number">30.0</span></span><span>, nA=</span><span><span class="hljs-number">16</span></span><span>, nB=</span><span><span class="hljs-number">16</span></span><span>, regime_change_sec=</span><span><span class="hljs-number">15.0</span></span><span>, seed=</span><span><span class="hljs-number">7</span></span><span>):
