</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">differential_entropy</span></span><span>(</span><span><span class="hljs-params">values: np.ndarray, method: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"histogram"</span></span><span>, bins: </span><span><span class="hljs-built_in">int</span></span><span> = </span><span><span class="hljs-literal">None</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
