6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-pseudo"><span>PROCEDURE BuildInterbrainGraph(XA, XB, ibs_metric, graph_topology, weight_threshold) -&gt; G
    # XA, XB: (n_channels × W) windows
    # Step 1: compute interbrain edge weights
    W_inter = zeros(nA, nB)
    FOR i IN 1..nA:
        FOR j IN 1..nB:
            W_inter[i,j] = IBS(XA[i,:], XB[j,:], ibs_metric)  # e.g., PLV, coherence, corr
        END FOR
    END FOR

    # Step 2: optional intra-brain scaffolds (stabilize neighborhoods)
    A_intra = IntraBrainScaffold(XA, graph_topology["intra"])  # e.g., kNN on sensors/ROIs
    B_intra = IntraBrainScaffold(XB, graph_topology["intra"])

    # Step 3: prune weak edges by global percentile (or FDR)
    τ = percentile(W_inter, weight_threshold["percentile"])
    W_inter = W_inter .* Indicator(W_inter &gt;= τ)

    # Step 4: assemble bipartite + intra layers
    G = Graph()
    G.add_nodes(A_1..A_nA, attrs={"hemisphere":"A"})
    G.add_nodes(B_1..B_nB, attrs={"hemisphere":"B"})
    G.add_weighted_edges_between(A_i, B_j, W_inter[i,j])
    G.add_weighted_edges_from_matrix_within(A_layer, A_intra)
    G.add_weighted_edges_from_matrix_within(B_layer, B_intra)

    RETURN G
END PROCEDURE
</span></code></div></div></pre>
