</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\;</span></span><span>q</span><span><span class="hljs-built_in">^</span></span><span>{(d)}(x</span><span><span class="hljs-built_in">_</span></span><span>t) = </span><span><span class="hljs-keyword">\mathcal</span></span><span>{I}</span><span><span class="hljs-built_in">^</span></span><span>d</span><span><span class="hljs-keyword">\big</span></span><span>(q(x</span><span><span class="hljs-built_in">_</span></span><span>{t-k})</span><span><span class="hljs-keyword">\big</span></span><span>),</span><span><span class="hljs-keyword">\;</span></span><span> k&gt;0</span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-built_in">$</span></span><span> </span><span><span class="hljs-built_in">&amp;</span></span><span>
