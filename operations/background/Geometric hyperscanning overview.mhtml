6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">import</span></span><span> networkx </span><span><span class="hljs-keyword">as</span></span><span> nx
</span><span><span class="hljs-keyword">import</span></span><span> numpy </span><span><span class="hljs-keyword">as</span></span><span> np

</span><span><span class="hljs-comment"># Entropy of weighted edges</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">graph_entropy</span></span><span>(</span><span><span class="hljs-params">G</span></span><span>):
    weights = np.array([d[</span><span><span class="hljs-string">"weight"</span></span><span>] </span><span><span class="hljs-keyword">for</span></span><span> _,_,d </span><span><span class="hljs-keyword">in</span></span><span> G.edges(data=</span><span><span class="hljs-literal">True</span></span><span>)])
    p = weights / weights.</span><span><span class="hljs-built_in">sum</span></span><span>()
    </span><span><span class="hljs-keyword">return</span></span><span> -np.</span><span><span class="hljs-built_in">sum</span></span><span>(p * np.log(p + </span><span><span class="hljs-number">1e-12</span></span><span>))

</span><span><span class="hljs-comment"># Simple Forman-Ricci curvature (toy: deg(u)+deg(v)-2 on each edge)</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">forman_curvature</span></span><span>(</span><span><span class="hljs-params">G</span></span><span>):
    curv = {}
    </span><span><span class="hljs-keyword">for</span></span><span> u,v </span><span><span class="hljs-keyword">in</span></span><span> G.edges():
        d_u, d_v = G.degree(u), G.degree(v)
        curv[(u,v)] = </span><span><span class="hljs-number">2</span></span><span> - (d_u + d_v)
    </span><span><span class="hljs-keyword">return</span></span><span> curv

</span><span><span class="hljs-comment"># Frame-shift: randomly rewire an edge</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">frame_shift</span></span><span>(</span><span><span class="hljs-params">G</span></span><span>):
    H = G.copy()
    u,v = </span><span><span class="hljs-built_in">list</span></span><span>(H.edges())[np.random.randint(H.number_of_edges())]
    H.remove_edge(u,v)
    new_u, new_v = np.random.choice(</span><span><span class="hljs-built_in">list</span></span><span>(H.nodes()), </span><span><span class="hljs-number">2</span></span><span>, replace=</span><span><span class="hljs-literal">False</span></span><span>)
    H.add_edge(new_u,new_v, weight=np.random.rand())
    </span><span><span class="hljs-keyword">return</span></span><span> H

</span><span><span class="hljs-comment"># Humor graph event</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">humor_graph_event</span></span><span>(</span><span><span class="hljs-params">G</span></span><span>):
    K1 = np.mean(</span><span><span class="hljs-built_in">list</span></span><span>(forman_curvature(G).values()))
    S1 = graph_entropy(G)
    
    G2 = frame_shift(G)
    
    K2 = np.mean(</span><span><span class="hljs-built_in">list</span></span><span>(forman_curvature(G2).values()))
    S2 = graph_entropy(G2)
    
    ΔS, ΔK = S2 - S1, K2 - K1
    intensity = ΔS * ΔK
    </span><span><span class="hljs-keyword">return</span></span><span> intensity, ΔS, ΔK, G2

</span><span><span class="hljs-comment"># Example graph (semantic manifold)</span></span><span>
G = nx.gnp_random_graph(</span><span><span class="hljs-number">10</span></span><span>, </span><span><span class="hljs-number">0.3</span></span><span>)
</span><span><span class="hljs-keyword">for</span></span><span> u,v </span><span><span class="hljs-keyword">in</span></span><span> G.edges():
    G[u][v][</span><span><span class="hljs-string">"weight"</span></span><span>] = np.random.rand()

intensity, ΔS, ΔK, G2 = humor_graph_event(G)

</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Entropy change ΔS = <span class="hljs-subst">{ΔS:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Curvature change ΔK = <span class="hljs-subst">{ΔK:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"Humor intensity = <span class="hljs-subst">{intensity:<span class="hljs-number">.3</span></span></span></span><span>f}")
</span></span></code></div></div></pre>
