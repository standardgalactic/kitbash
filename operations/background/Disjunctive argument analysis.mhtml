</span><span><span class="hljs-keyword">\subsection</span></span><span>{Syntax}

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\begin</span></span><span>{array}{rcll}
t,u </span><span><span class="hljs-built_in">&amp;</span></span><span> ::= </span><span><span class="hljs-built_in">&amp;</span></span><span> x </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{variable} </span><span><span class="hljs-keyword">\\</span></span><span>
     </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-built_in">&amp;</span></span><span> a </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{atom / constant} </span><span><span class="hljs-keyword">\\</span></span><span>
     </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Sphere}(x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>t) </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{abstraction} </span><span><span class="hljs-keyword">\\</span></span><span>
