6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-comment"># ===== Spherepop Calculus (SPC) — Minimal Working Prototype =====</span></span><span>
</span><span><span class="hljs-comment"># Python 3.10+ (pattern matching). No external deps.</span></span><span>

</span><span><span class="hljs-keyword">from</span></span><span> __future__ </span><span><span class="hljs-keyword">import</span></span><span> annotations
</span><span><span class="hljs-keyword">from</span></span><span> dataclasses </span><span><span class="hljs-keyword">import</span></span><span> dataclass
</span><span><span class="hljs-keyword">from</span></span><span> typing </span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-type">Optional</span></span><span>, </span><span><span class="hljs-type">Union</span></span><span>, </span><span><span class="hljs-type">Tuple</span></span><span>, </span><span><span class="hljs-type">List</span></span><span>, </span><span><span class="hljs-type">Dict</span></span><span>, </span><span><span class="hljs-type">Set</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> itertools
</span><span><span class="hljs-keyword">import</span></span><span> random

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 1) Core AST</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Var</span></span><span>:
    name: </span><span><span class="hljs-built_in">str</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Atom</span></span><span>:
    value: </span><span><span class="hljs-built_in">str</span></span><span>  </span><span><span class="hljs-comment"># e.g., "Safe", "Doom", "true", "false", "W0", "+", etc.</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>:
    </span><span><span class="hljs-comment"># Abstraction / lambda: Sphere(x, body)</span></span><span>
    param: </span><span><span class="hljs-built_in">str</span></span><span>
    body: </span><span><span class="hljs-string">"Term"</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Pop</span></span><span>:
    </span><span><span class="hljs-comment"># Application: Pop(f, arg)</span></span><span>
    fn: </span><span><span class="hljs-string">"Term"</span></span><span>
    arg: </span><span><span class="hljs-string">"Term"</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Merge</span></span><span>:
    </span><span><span class="hljs-comment"># Parallel composition (associative/commutative up to normalization)</span></span><span>
    left: </span><span><span class="hljs-string">"Term"</span></span><span>
    right: </span><span><span class="hljs-string">"Term"</span></span><span>

</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Nest</span></span><span>:
    </span><span><span class="hljs-comment"># Syntactic sugar for delayed application; reduces to Pop</span></span><span>
    fn: </span><span><span class="hljs-string">"Term"</span></span><span>
    arg: </span><span><span class="hljs-string">"Term"</span></span><span>

</span><span><span class="hljs-comment"># Optional: probabilistic choice (for pSPC)</span></span><span>
</span><span><span class="hljs-meta">@dataclass(<span class="hljs-params">frozen=<span class="hljs-literal">True</span></span></span></span><span>)
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Choice</span></span><span>:
    p: </span><span><span class="hljs-built_in">float</span></span><span>           </span><span><span class="hljs-comment"># 0&lt;=p&lt;=1</span></span><span>
    left: </span><span><span class="hljs-string">"Term"</span></span><span>       </span><span><span class="hljs-comment"># chosen w.p. p</span></span><span>
    right: </span><span><span class="hljs-string">"Term"</span></span><span>      </span><span><span class="hljs-comment"># chosen w.p. 1-p</span></span><span>

Term = </span><span><span class="hljs-type">Union</span></span><span>[Var, Atom, Sphere, Pop, Merge, Nest, Choice]

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 2) Pretty printer and helpers</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">pp</span></span><span>(</span><span><span class="hljs-params">t: Term</span></span><span>) -&gt; </span><span><span class="hljs-built_in">str</span></span><span>:
    </span><span><span class="hljs-keyword">match</span></span><span> t:
        </span><span><span class="hljs-keyword">case</span></span><span> Var(x): </span><span><span class="hljs-keyword">return</span></span><span> x
        </span><span><span class="hljs-keyword">case</span></span><span> Atom(v): </span><span><span class="hljs-keyword">return</span></span><span> v
        </span><span><span class="hljs-keyword">case</span></span><span> Sphere(x, b): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"(Sphere <span class="hljs-subst">{x}</span></span></span><span>. </span><span><span class="hljs-subst">{pp(b)}</span></span><span>)"
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"Pop(<span class="hljs-subst">{pp(f)}</span></span></span><span>, </span><span><span class="hljs-subst">{pp(a)}</span></span><span>)"
        </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"Merge(<span class="hljs-subst">{pp(l)}</span></span></span><span>, </span><span><span class="hljs-subst">{pp(r)}</span></span><span>)"
        </span><span><span class="hljs-keyword">case</span></span><span> Nest(f, a): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"Nest(<span class="hljs-subst">{pp(f)}</span></span></span><span>, </span><span><span class="hljs-subst">{pp(a)}</span></span><span>)"
        </span><span><span class="hljs-keyword">case</span></span><span> Choice(p, l, r): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"Choice(<span class="hljs-subst">{p:<span class="hljs-number">.3</span></span></span></span><span>f}, </span><span><span class="hljs-subst">{pp(l)}</span></span><span>, </span><span><span class="hljs-subst">{pp(r)}</span></span><span>)"
    </span><span><span class="hljs-keyword">raise</span></span><span> TypeError(</span><span><span class="hljs-string">"Unknown term"</span></span><span>)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">is_value</span></span><span>(</span><span><span class="hljs-params">t: Term</span></span><span>) -&gt; </span><span><span class="hljs-built_in">bool</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">isinstance</span></span><span>(t, (Atom, Sphere))

</span><span><span class="hljs-comment"># gensym for capture-avoidance</span></span><span>
_gensym_ctr = itertools.count()
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">gensym</span></span><span>(</span><span><span class="hljs-params">prefix: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"x"</span></span><span>) -&gt; </span><span><span class="hljs-built_in">str</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"<span class="hljs-subst">{prefix}</span></span></span><span>_</span><span><span class="hljs-subst">{<span class="hljs-built_in">next</span></span></span><span>(_gensym_ctr)}"

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">free_vars</span></span><span>(</span><span><span class="hljs-params">t: Term</span></span><span>) -&gt; </span><span><span class="hljs-type">Set</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]:
    </span><span><span class="hljs-keyword">match</span></span><span> t:
        </span><span><span class="hljs-keyword">case</span></span><span> Var(x): </span><span><span class="hljs-keyword">return</span></span><span> {x}
        </span><span><span class="hljs-keyword">case</span></span><span> Atom(_): </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">set</span></span><span>()
        </span><span><span class="hljs-keyword">case</span></span><span> Sphere(param, body):
            </span><span><span class="hljs-keyword">return</span></span><span> free_vars(body) - {param}
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> free_vars(f) | free_vars(a)
        </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> free_vars(l) | free_vars(r)
        </span><span><span class="hljs-keyword">case</span></span><span> Nest(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> free_vars(f) | free_vars(a)
        </span><span><span class="hljs-keyword">case</span></span><span> Choice(_, l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> free_vars(l) | free_vars(r)
    </span><span><span class="hljs-keyword">raise</span></span><span> TypeError(</span><span><span class="hljs-string">"Unknown term"</span></span><span>)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">substitute</span></span><span>(</span><span><span class="hljs-params">t: Term, x: <span class="hljs-built_in">str</span></span></span><span>, u: Term) -&gt; Term:
    </span><span><span class="hljs-string">"""Capture-avoiding substitution t[u/x]."""</span></span><span>
    </span><span><span class="hljs-keyword">match</span></span><span> t:
        </span><span><span class="hljs-keyword">case</span></span><span> Var(y):
            </span><span><span class="hljs-keyword">return</span></span><span> u </span><span><span class="hljs-keyword">if</span></span><span> y == x </span><span><span class="hljs-keyword">else</span></span><span> t
        </span><span><span class="hljs-keyword">case</span></span><span> Atom(_):
            </span><span><span class="hljs-keyword">return</span></span><span> t
        </span><span><span class="hljs-keyword">case</span></span><span> Sphere(param, body):
            </span><span><span class="hljs-keyword">if</span></span><span> param == x:
                </span><span><span class="hljs-keyword">return</span></span><span> t  </span><span><span class="hljs-comment"># x bound here; stop</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> param </span><span><span class="hljs-keyword">in</span></span><span> free_vars(u):
                </span><span><span class="hljs-comment"># alpha-rename</span></span><span>
                fresh = gensym(param)
                body_renamed = substitute(body, param, Var(fresh))
                </span><span><span class="hljs-keyword">return</span></span><span> Sphere(fresh, substitute(body_renamed, x, u))
            </span><span><span class="hljs-keyword">else</span></span><span>:
                </span><span><span class="hljs-keyword">return</span></span><span> Sphere(param, substitute(body, x, u))
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> Pop(substitute(f, x, u), substitute(a, x, u))
        </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> Merge(substitute(l, x, u), substitute(r, x, u))
        </span><span><span class="hljs-keyword">case</span></span><span> Nest(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> Nest(substitute(f, x, u), substitute(a, x, u))
        </span><span><span class="hljs-keyword">case</span></span><span> Choice(p, l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> Choice(p, substitute(l, x, u), substitute(r, x, u))
    </span><span><span class="hljs-keyword">raise</span></span><span> TypeError(</span><span><span class="hljs-string">"Unknown term"</span></span><span>)

</span><span><span class="hljs-comment"># Normalize Merge into a right-associated chain to make stepping deterministic</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">normalize_merge</span></span><span>(</span><span><span class="hljs-params">t: Term</span></span><span>) -&gt; Term:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">flatten</span></span><span>(</span><span><span class="hljs-params">m: Term</span></span><span>) -&gt; </span><span><span class="hljs-type">List</span></span><span>[Term]:
        </span><span><span class="hljs-keyword">match</span></span><span> m:
            </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r): </span><span><span class="hljs-keyword">return</span></span><span> flatten(l) + flatten(r)
            </span><span><span class="hljs-keyword">case</span></span><span> _: </span><span><span class="hljs-keyword">return</span></span><span> [m]
    xs = flatten(t)
    </span><span><span class="hljs-comment"># optional: sort for determinism of commutativity</span></span><span>
    xs = </span><span><span class="hljs-built_in">sorted</span></span><span>(xs, key=pp)
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">build</span></span><span>(</span><span><span class="hljs-params">lst: <span class="hljs-type">List</span></span></span><span>[Term]) -&gt; Term:
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> lst: </span><span><span class="hljs-keyword">return</span></span><span> Atom(</span><span><span class="hljs-string">"Unit"</span></span><span>)
        acc = lst[</span><span><span class="hljs-number">0</span></span><span>]
        </span><span><span class="hljs-keyword">for</span></span><span> z </span><span><span class="hljs-keyword">in</span></span><span> lst[</span><span><span class="hljs-number">1</span></span><span>:]:
            acc = Merge(acc, z)
        </span><span><span class="hljs-keyword">return</span></span><span> acc
    </span><span><span class="hljs-keyword">return</span></span><span> build(xs)

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 3) Small-step evaluator</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">step</span></span><span>(</span><span><span class="hljs-params">t: Term, rnd: <span class="hljs-type">Optional</span></span></span><span>[random.Random] = </span><span><span class="hljs-literal">None</span></span><span>) -&gt; </span><span><span class="hljs-type">Optional</span></span><span>[Term]:
    </span><span><span class="hljs-string">"""One small-step; return None if no step (value or stuck)."""</span></span><span>
    </span><span><span class="hljs-comment"># Handle syntactic sugar Nest -&gt; Pop</span></span><span>
    </span><span><span class="hljs-keyword">match</span></span><span> t:
        </span><span><span class="hljs-keyword">case</span></span><span> Nest(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> Pop(f, a)
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(Sphere(x, body), arg) </span><span><span class="hljs-keyword">if</span></span><span> is_value(arg):
            </span><span><span class="hljs-comment"># β-reduction</span></span><span>
            </span><span><span class="hljs-keyword">return</span></span><span> substitute(body, x, arg)
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a) </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> is_value(f):
            nf = step(f, rnd)
            </span><span><span class="hljs-keyword">return</span></span><span> Pop(nf, a) </span><span><span class="hljs-keyword">if</span></span><span> nf </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a) </span><span><span class="hljs-keyword">if</span></span><span> is_value(f) </span><span><span class="hljs-keyword">and</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> is_value(a):
            na = step(a, rnd)
            </span><span><span class="hljs-keyword">return</span></span><span> Pop(f, na) </span><span><span class="hljs-keyword">if</span></span><span> na </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>
        </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r):
            </span><span><span class="hljs-comment"># normalize to choose a deterministic leftmost redex</span></span><span>
            l = normalize_merge(l)
            r = normalize_merge(r)
            ls = step(l, rnd)
            </span><span><span class="hljs-keyword">if</span></span><span> ls </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
                </span><span><span class="hljs-keyword">return</span></span><span> normalize_merge(Merge(ls, r))
            rs = step(r, rnd)
            </span><span><span class="hljs-keyword">if</span></span><span> rs </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
                </span><span><span class="hljs-keyword">return</span></span><span> normalize_merge(Merge(l, rs))
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>
        </span><span><span class="hljs-keyword">case</span></span><span> Sphere(x, body):
            nb = step(body, rnd)
            </span><span><span class="hljs-keyword">return</span></span><span> Sphere(x, nb) </span><span><span class="hljs-keyword">if</span></span><span> nb </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>
        </span><span><span class="hljs-keyword">case</span></span><span> Choice(p, l, r):
            </span><span><span class="hljs-comment"># probabilistic choice -- intensional step:</span></span><span>
            rng = rnd </span><span><span class="hljs-keyword">or</span></span><span> random
            </span><span><span class="hljs-keyword">return</span></span><span> l </span><span><span class="hljs-keyword">if</span></span><span> rng.random() &lt; p </span><span><span class="hljs-keyword">else</span></span><span> r
        </span><span><span class="hljs-keyword">case</span></span><span> _:
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">evaluate</span></span><span>(</span><span><span class="hljs-params">t: Term, max_steps: <span class="hljs-built_in">int</span></span></span><span> = </span><span><span class="hljs-number">1000</span></span><span>, rnd: </span><span><span class="hljs-type">Optional</span></span><span>[random.Random] = </span><span><span class="hljs-literal">None</span></span><span>) -&gt; Term:
    cur = normalize_merge(t)
    </span><span><span class="hljs-keyword">for</span></span><span> _ </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(max_steps):
        nxt = step(cur, rnd)
        </span><span><span class="hljs-keyword">if</span></span><span> nxt </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
            </span><span><span class="hljs-keyword">return</span></span><span> cur
        cur = nxt
    </span><span><span class="hljs-keyword">raise</span></span><span> RuntimeError(</span><span><span class="hljs-string">"Non-terminating or too many steps"</span></span><span>)

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 4) Library: Or, FoldOr and helpers for disjunction over merges</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-comment"># Or := λx. λy. Or2(x,y) with axioms Or2(Doom,y)=Doom; Or2(Safe,y)=y</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">mk_or</span></span><span>() -&gt; Term:
    y = </span><span><span class="hljs-string">"y"</span></span><span>
    x = </span><span><span class="hljs-string">"x"</span></span><span>
    </span><span><span class="hljs-comment"># We encode Or2 with a conditional on Atom values (Doom/Safe) at eval time.</span></span><span>
    </span><span><span class="hljs-comment"># Here we embed a tiny evaluator-level primitive via a Python helper application.</span></span><span>
    </span><span><span class="hljs-comment"># To keep SPC pure, we instead create an SPC-level curried function whose body</span></span><span>
    </span><span><span class="hljs-comment"># is a placeholder Atom we recognize: Atom("Or2")</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> Sphere(x, Sphere(y, Pop(Pop(Atom(</span><span><span class="hljs-string">"Or2"</span></span><span>), Var(x)), Var(y))))

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">apply_or2</span></span><span>(</span><span><span class="hljs-params">x: Term, y: Term</span></span><span>) -&gt; Term:
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">isinstance</span></span><span>(x, Atom) </span><span><span class="hljs-keyword">and</span></span><span> x.value == </span><span><span class="hljs-string">"Doom"</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> Atom(</span><span><span class="hljs-string">"Doom"</span></span><span>)
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">isinstance</span></span><span>(x, Atom) </span><span><span class="hljs-keyword">and</span></span><span> x.value == </span><span><span class="hljs-string">"Safe"</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> y
    </span><span><span class="hljs-comment"># If not yet values, keep it symbolic:</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> Pop(Pop(Atom(</span><span><span class="hljs-string">"Or2"</span></span><span>), x), y)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">delta_reduce_primitives</span></span><span>(</span><span><span class="hljs-params">t: Term</span></span><span>) -&gt; Term:
    </span><span><span class="hljs-string">"""One pass of primitive reductions (Or2 only)."""</span></span><span>
    </span><span><span class="hljs-keyword">match</span></span><span> t:
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(Pop(Atom(</span><span><span class="hljs-string">"Or2"</span></span><span>), x), y):
            </span><span><span class="hljs-keyword">if</span></span><span> is_value(x) </span><span><span class="hljs-keyword">and</span></span><span> is_value(y):
                </span><span><span class="hljs-keyword">return</span></span><span> apply_or2(x, y)
            </span><span><span class="hljs-keyword">else</span></span><span>:
                </span><span><span class="hljs-keyword">return</span></span><span> Pop(Pop(Atom(</span><span><span class="hljs-string">"Or2"</span></span><span>), delta_reduce_primitives(x)),
                           delta_reduce_primitives(y))
        </span><span><span class="hljs-keyword">case</span></span><span> Sphere(x, b):
            </span><span><span class="hljs-keyword">return</span></span><span> Sphere(x, delta_reduce_primitives(b))
        </span><span><span class="hljs-keyword">case</span></span><span> Pop(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> Pop(delta_reduce_primitives(f), delta_reduce_primitives(a))
        </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> Merge(delta_reduce_primitives(l), delta_reduce_primitives(r))
        </span><span><span class="hljs-keyword">case</span></span><span> Nest(f, a):
            </span><span><span class="hljs-keyword">return</span></span><span> Nest(delta_reduce_primitives(f), delta_reduce_primitives(a))
        </span><span><span class="hljs-keyword">case</span></span><span> Choice(p, l, r):
            </span><span><span class="hljs-keyword">return</span></span><span> Choice(p, delta_reduce_primitives(l), delta_reduce_primitives(r))
        </span><span><span class="hljs-keyword">case</span></span><span> _:
            </span><span><span class="hljs-keyword">return</span></span><span> t

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">evaluate_with_prims</span></span><span>(</span><span><span class="hljs-params">t: Term, max_steps: <span class="hljs-built_in">int</span></span></span><span> = </span><span><span class="hljs-number">1000</span></span><span>, rnd: </span><span><span class="hljs-type">Optional</span></span><span>[random.Random] = </span><span><span class="hljs-literal">None</span></span><span>) -&gt; Term:
    cur = normalize_merge(t)
    </span><span><span class="hljs-keyword">for</span></span><span> _ </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(max_steps):
        </span><span><span class="hljs-comment"># First try β/structural/prob steps</span></span><span>
        nxt = step(cur, rnd)
        </span><span><span class="hljs-keyword">if</span></span><span> nxt </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
            cur = normalize_merge(nxt)
            </span><span><span class="hljs-keyword">continue</span></span><span>
        </span><span><span class="hljs-comment"># Then try a primitive "delta" reduction (Or2)</span></span><span>
        d = delta_reduce_primitives(cur)
        </span><span><span class="hljs-keyword">if</span></span><span> d != cur:
            cur = normalize_merge(d)
            </span><span><span class="hljs-keyword">continue</span></span><span>
        </span><span><span class="hljs-keyword">return</span></span><span> cur
    </span><span><span class="hljs-keyword">raise</span></span><span> RuntimeError(</span><span><span class="hljs-string">"Non-terminating or too many steps"</span></span><span>)

</span><span><span class="hljs-comment"># FoldOr over a Merge forest</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fold_or</span></span><span>(</span><span><span class="hljs-params">reasons: Term, world: Term</span></span><span>) -&gt; Term:
    </span><span><span class="hljs-string">"""Builds an SPC term equivalent to folding Or over [Pop(R_i, world)]."""</span></span><span>
    Or = mk_or()
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">flatten</span></span><span>(</span><span><span class="hljs-params">m: Term</span></span><span>) -&gt; </span><span><span class="hljs-type">List</span></span><span>[Term]:
        </span><span><span class="hljs-keyword">match</span></span><span> m:
            </span><span><span class="hljs-keyword">case</span></span><span> Merge(l, r): </span><span><span class="hljs-keyword">return</span></span><span> flatten(l) + flatten(r)
            </span><span><span class="hljs-keyword">case</span></span><span> _: </span><span><span class="hljs-keyword">return</span></span><span> [m]
    rs = flatten(normalize_merge(reasons))
    </span><span><span class="hljs-comment"># map: Pop(R_i, world)</span></span><span>
    applied = [Pop(r, world) </span><span><span class="hljs-keyword">for</span></span><span> r </span><span><span class="hljs-keyword">in</span></span><span> rs]
    </span><span><span class="hljs-comment"># fold with Or</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> applied:
        </span><span><span class="hljs-keyword">return</span></span><span> Atom(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    acc = applied[</span><span><span class="hljs-number">0</span></span><span>]
    </span><span><span class="hljs-keyword">for</span></span><span> t </span><span><span class="hljs-keyword">in</span></span><span> applied[</span><span><span class="hljs-number">1</span></span><span>:]:
        acc = Pop(Pop(Or, acc), t)
    </span><span><span class="hljs-keyword">return</span></span><span> acc

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 5) Convenience constructors for demos</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">lam</span></span><span>(</span><span><span class="hljs-params">x: <span class="hljs-built_in">str</span></span></span><span>, body: Term) -&gt; Term:
    </span><span><span class="hljs-keyword">return</span></span><span> Sphere(x, body)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">app</span></span><span>(</span><span><span class="hljs-params">f: Term, a: Term</span></span><span>) -&gt; Term:
    </span><span><span class="hljs-keyword">return</span></span><span> Pop(f, a)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">merge_many</span></span><span>(</span><span><span class="hljs-params">ts: <span class="hljs-type">List</span></span></span><span>[Term]) -&gt; Term:
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> ts: </span><span><span class="hljs-keyword">return</span></span><span> Atom(</span><span><span class="hljs-string">"Unit"</span></span><span>)
    acc = ts[</span><span><span class="hljs-number">0</span></span><span>]
    </span><span><span class="hljs-keyword">for</span></span><span> z </span><span><span class="hljs-keyword">in</span></span><span> ts[</span><span><span class="hljs-number">1</span></span><span>:]:
        acc = Merge(acc, z)
    </span><span><span class="hljs-keyword">return</span></span><span> normalize_merge(acc)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">bernout</span></span><span>(</span><span><span class="hljs-params">p: <span class="hljs-built_in">float</span></span></span><span>) -&gt; Term:
    </span><span><span class="hljs-keyword">return</span></span><span> Choice(p, Atom(</span><span><span class="hljs-string">"Doom"</span></span><span>), Atom(</span><span><span class="hljs-string">"Safe"</span></span><span>))

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">reason_const</span></span><span>(</span><span><span class="hljs-params">outcome: <span class="hljs-built_in">str</span></span></span><span>) -&gt; Term:
    </span><span><span class="hljs-comment"># R := λw. outcome</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> lam(</span><span><span class="hljs-string">"w"</span></span><span>, Atom(outcome))

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">reason_prob</span></span><span>(</span><span><span class="hljs-params">p: <span class="hljs-built_in">float</span></span></span><span>) -&gt; Term:
    </span><span><span class="hljs-comment"># R := λw. BernOut(p)</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> lam(</span><span><span class="hljs-string">"w"</span></span><span>, bernout(p))

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 6) Demos</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">if</span></span><span> __name__ == </span><span><span class="hljs-string">"__main__"</span></span><span>:
    rng = random.Random(</span><span><span class="hljs-number">42</span></span><span>)

    </span><span><span class="hljs-comment"># --- A) Deterministic disjunctive doom (one channel dooms) ---</span></span><span>
    W0 = Atom(</span><span><span class="hljs-string">"W0"</span></span><span>)
    R_A = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    R_B = reason_const(</span><span><span class="hljs-string">"Doom"</span></span><span>)
    R_C = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    reasons = merge_many([R_A, R_B, R_C])
    term = fold_or(reasons, W0)
    res = evaluate_with_prims(term)
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"[A] Deterministic disjunction =&gt;"</span></span><span>, pp(res))  </span><span><span class="hljs-comment"># expect Doom</span></span><span>

    </span><span><span class="hljs-comment"># --- B) Probabilistic channels (independent hazards) ---</span></span><span>
    </span><span><span class="hljs-comment"># p1=0.2, p2=0.5, p3=0.05  =&gt; P(Doom) = 1 - (0.8*0.5*0.95) = 0.62</span></span><span>
    R1 = reason_prob(</span><span><span class="hljs-number">0.2</span></span><span>)
    R2 = reason_prob(</span><span><span class="hljs-number">0.5</span></span><span>)
    R3 = reason_prob(</span><span><span class="hljs-number">0.05</span></span><span>)
    reasons_p = merge_many([R1, R2, R3])
    term_p = fold_or(reasons_p, W0)

    </span><span><span class="hljs-comment"># Monte Carlo estimate with small-step stochastic Choice</span></span><span>
    N = </span><span><span class="hljs-number">10000</span></span><span>
    doom = </span><span><span class="hljs-number">0</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> _ </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(N):
        out = evaluate_with_prims(term_p, rnd=rng)
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">isinstance</span></span><span>(out, Atom) </span><span><span class="hljs-keyword">and</span></span><span> out.value == </span><span><span class="hljs-string">"Doom"</span></span><span>:
            doom += </span><span><span class="hljs-number">1</span></span><span>
    est = doom / N
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[B] Probabilistic disjunction (Monte Carlo) ~ <span class="hljs-subst">{est:<span class="hljs-number">.3</span></span></span></span><span>f} (theory: 0.620)")
</span></span></code></div></div></pre>
<h3 data-start="11724" data-end="11753">What this gives you today</h3>
<ul data-start="11754" data-end="12175">
<li data-start="11754" data-end="11894">
<p data-start="11756" data-end="11894"><strong data-start="11756" data-end="11774">Core SPC terms</strong> and <strong data-start="11779" data-end="11794">β-reduction</strong> (<code data-start="11796" data-end="11804">Sphere</code>/<code data-start="11805" data-end="11810">Pop</code>), <strong data-start="11813" data-end="11825">Nest→Pop</strong>, and deterministic <strong data-start="11845" data-end="11854">Merge</strong> normalization for predictable stepping.</p>
</li>
<li data-start="11895" data-end="11967">
<p data-start="11897" data-end="11967">A tiny “primitive” (<code data-start="11917" data-end="11922">Or2</code>) to make the disjunctive fold computational.</p>
</li>
<li data-start="11968" data-end="12040">
<p data-start="11970" data-end="12040">A <strong data-start="11972" data-end="11989">probabilistic</strong> <code data-start="11990" data-end="12004">Choice(p, …)</code> node for independent-channel demos.</p>
</li>
<li data-start="12041" data-end="12175">
<p data-start="12043" data-end="12053">Two demos:</p>
<ul data-start="12056" data-end="12175">
<li data-start="12056" data-end="12100">
<p data-start="12058" data-end="12100">deterministic disjunction → prints <code data-start="12093" data-end="12099">Doom</code>,</p>
</li>
<li data-start="12103" data-end="12175">
<p data-start="12105" data-end="12175">probabilistic Monte Carlo → ~0.620 as predicted by <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mn>1</mn><mo>−</mo><mo>∏</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">1-\prod(1-p_i)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.7278em; vertical-align: -0.0833em;"></span><span class="mord">1</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mop op-symbol small-op" style="position: relative; top: 0em;">∏</span><span class="mopen">(</span><span class="mord">1</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord"><span class="mord mathnormal">p</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3117em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">i</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mclose">)</span></span></span></span>.</p>
</li>
