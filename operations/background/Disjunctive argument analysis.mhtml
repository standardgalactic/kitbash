        </span><span><span class="hljs-string">"edges"</span></span><span>: [{</span><span><span class="hljs-string">"source"</span></span><span>: u, </span><span><span class="hljs-string">"target"</span></span><span>: v} </span><span><span class="hljs-keyword">for</span></span><span> u,v </span><span><span class="hljs-keyword">in</span></span><span> G.edges()]
    }
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(filename, </span><span><span class="hljs-string">"w"</span></span><span>) </span><span><span class="hljs-keyword">as</span></span><span> f:
