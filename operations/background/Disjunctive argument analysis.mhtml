</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Typing Rules}

Contexts: </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> ::= </span><span><span class="hljs-keyword">\cdot</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A</span><span><span class="hljs-built_in">$</span></span><span>.

</span><span><span class="hljs-keyword">\begin</span></span><span>{mathpar}
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Var]
  {x{:}A </span><span><span class="hljs-keyword">\in</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> x : A}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Atom]
  { }
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : A}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Form]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> A : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>i </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>j}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\max</span></span><span>(i,j)}}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Intro]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> t : B}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Sphere}(x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>t) : </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Elim]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> f : </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop}(f,u) : B[u/x]}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Merge]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u) : A}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Choice]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> p : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} </span><span><span class="hljs-keyword">\\</span></span><span>
   </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A </span><span><span class="hljs-keyword">\\</span></span><span>
   </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Choice}(p,t,u) : A}
</span><span><span class="hljs-keyword">\end</span></span><span>{mathpar}

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Operational Semantics}

</span><span><span class="hljs-keyword">\begin</span></span><span>{align*}
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop}(</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Sphere}(x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>t),u) </span><span><span class="hljs-built_in">&amp;</span></span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-keyword">\to</span></span><span><span class="hljs-keyword">\;</span></span><span> t[u/x] </span><span><span class="hljs-keyword">\\</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Nest}(t,u) </span><span><span class="hljs-built_in">&amp;</span></span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-keyword">\to</span></span><span><span class="hljs-keyword">\;</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop}(t,u) </span><span><span class="hljs-keyword">\\</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Choice}(p,t,u) </span><span><span class="hljs-built_in">&amp;</span></span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-keyword">\to</span></span><span><span class="hljs-keyword">\;</span></span><span> </span><span><span class="hljs-keyword">\begin</span></span><span>{cases}
t </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{with prob.</span><span><span class="hljs-keyword">\ </span></span><span>} p </span><span><span class="hljs-keyword">\\</span></span><span>
u </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{with prob.</span><span><span class="hljs-keyword">\ </span></span><span>} 1-p
</span><span><span class="hljs-keyword">\end</span></span><span>{cases}
</span><span><span class="hljs-keyword">\end</span></span><span>{align*}

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u) </span><span><span class="hljs-keyword">\equiv</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(u,t),
</span><span><span class="hljs-keyword">\quad</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(u,v)) </span><span><span class="hljs-keyword">\equiv</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u),v)
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Categorical Semantics}

The Spherepop calculus admits a categorical model, connecting syntax and types with semantic structures.

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Monoidal Functorial Semantics.}
The operator
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop} : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere} </span><span><span class="hljs-keyword">\to</span></span><span> [</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Field}, </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Field}]
</span><span><span class="hljs-keyword">\]</span></span><span>
is a </span><span><span class="hljs-keyword">\emph</span></span><span>{monoidal functor}, preserving tensor products, the monoidal unit, and coherence isomorphisms (associator, left/right unitors).

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{2-Category </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere}</span><span><span class="hljs-built_in">^</span></span><span>2</span><span><span class="hljs-built_in">$</span></span><span>.}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> 0-cells: regions </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Omega</span></span><span> </span><span><span class="hljs-keyword">\subseteq</span></span><span> </span><span><span class="hljs-keyword">\mathbb</span></span><span>{R}</span><span><span class="hljs-built_in">^</span></span><span>n</span><span><span class="hljs-built_in">$</span></span><span>.
</span><span><span class="hljs-keyword">\item</span></span><span> 1-cells: spheres (supports with morphism data).
</span><span><span class="hljs-keyword">\item</span></span><span> 2-cells: natural transformations </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\tau</span></span><span> : </span><span><span class="hljs-keyword">\sigma</span></span><span><span class="hljs-built_in">_</span></span><span>1 </span><span><span class="hljs-keyword">\Rightarrow</span></span><span> </span><span><span class="hljs-keyword">\sigma</span></span><span><span class="hljs-built_in">_</span></span><span>2</span><span><span class="hljs-built_in">$</span></span><span>.
</span><span><span class="hljs-keyword">\item</span></span><span> Composition: horizontal and vertical, satisfying strict 2-category axioms.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Topos Semantics.}
The presheaf category
</span><span><span class="hljs-keyword">\[</span></span><span>
[</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere}</span><span><span class="hljs-built_in">^</span></span><span>{op}, </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Set}]
</span><span><span class="hljs-keyword">\]</span></span><span>
forms a topos, providing:
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> Subobject classifier (truth sphere).
</span><span><span class="hljs-keyword">\item</span></span><span> Finite limits and colimits.
</span><span><span class="hljs-keyword">\item</span></span><span> Exponentials.
</span><span><span class="hljs-keyword">\item</span></span><span> Internal intuitionistic higher-order logic, where propositions are subspheres, and proofs are morphisms preserving truth.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Soundness and Preservation}

</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> Typing judgments </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A</span><span><span class="hljs-built_in">$</span></span><span> correspond to morphisms in the presheaf topos.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\beta</span></span><span><span class="hljs-built_in">$</span></span><span>-reduction corresponds to naturality of evaluation morphisms.
</span><span><span class="hljs-keyword">\item</span></span><span> Merge corresponds to the tensor product in the monoidal structure.
</span><span><span class="hljs-keyword">\item</span></span><span> Choice corresponds to probabilistic enrichment of the topos.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Theorem (Subject Reduction).}
If </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A</span><span><span class="hljs-built_in">$</span></span><span> and </span><span><span class="hljs-built_in">$</span></span><span>t </span><span><span class="hljs-keyword">\to</span></span><span> t'</span><span><span class="hljs-built_in">$</span></span><span>, then </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t' : A</span><span><span class="hljs-built_in">$</span></span><span>.
</span><span><span class="hljs-keyword">\medskip</span></span><span>

Thus, SPC enjoys both type safety (preservation) and a categorical semantics unifying computation, geometry, and probabilistic reasoning.

</span></span></code></div></div></pre>
