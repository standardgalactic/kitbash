</span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span>(</span><span><span class="hljs-keyword">\overline</span></span><span>{a}</span><span><span class="hljs-keyword">\langle</span></span><span> b</span><span><span class="hljs-keyword">\rangle</span></span><span>.P) </span><span><span class="hljs-built_in">&amp;</span></span><span>= </span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span>(P) </span><span><span class="hljs-keyword">\\</span></span><span>
