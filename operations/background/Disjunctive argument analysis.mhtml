</span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\mathrm</span></span><span>{prob}</span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\lambda</span></span><span>}</span><span><span class="hljs-built_in">^</span></span><span>{</span><span><span class="hljs-keyword">\mathsf</span></span><span>{mon}}(</span><span><span class="hljs-keyword">\mathbf</span></span><span>{choice}(p,e</span><span><span class="hljs-built_in">_</span></span><span>1,e</span><span><span class="hljs-built_in">_</span></span><span>2))
