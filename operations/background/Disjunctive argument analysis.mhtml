</span><span><span class="hljs-keyword">\subsection</span></span><span>*{Typing Rules}

Contexts: </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> ::= </span><span><span class="hljs-keyword">\cdot</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A</span><span><span class="hljs-built_in">$</span></span><span>.

</span><span><span class="hljs-keyword">\begin</span></span><span>{mathpar}
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Var]
  {x{:}A </span><span><span class="hljs-keyword">\in</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> x : A}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Atom]
  { }
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : A}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Form]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> A : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>i </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>j}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\max</span></span><span>(i,j)}}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Intro]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> t : B}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Sphere}(x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>t) : </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Pi</span></span><span><span class="hljs-built_in">$</span></span><span>-Elim]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> f : </span><span><span class="hljs-keyword">\Pi</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop}(f,u) : B[u/x]}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Sigma</span></span><span><span class="hljs-built_in">$</span></span><span>-Form]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> A : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>i </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>j}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\Sigma</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\max</span></span><span>(i,j)}}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Sigma</span></span><span><span class="hljs-built_in">$</span></span><span>-Intro]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : A </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> b : B[a/x]}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> (a,b) : </span><span><span class="hljs-keyword">\Sigma</span></span><span> x{:}A.</span><span><span class="hljs-keyword">\,</span></span><span>B}

</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Merge]
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A </span><span><span class="hljs-keyword">\\</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A}
  {</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u) : A}
