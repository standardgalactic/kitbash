    </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-title function_">pp</span></span><span>(reduced) !== </span><span><span class="hljs-title function_">pp</span></span><span>(term)) {
      div.</span><span><span class="hljs-property">classList</span></span><span>.</span><span><span class="hljs-title function_">add</span></span><span>(</span><span><span class="hljs-string">"popped"</span></span><span>);
      </span><span><span class="hljs-built_in">setTimeout</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
        div.</span><span><span class="hljs-property">innerHTML</span></span><span> = </span><span><span class="hljs-string">"&lt;span class='text'&gt;"</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(reduced) + </span><span><span class="hljs-string">"&lt;/span&gt;"</span></span><span>;
