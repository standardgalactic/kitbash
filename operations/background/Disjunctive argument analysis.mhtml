</span><span><span class="hljs-comment">// ----- β-reduction step (simplified) -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">substitute</span></span><span>(</span><span><span class="hljs-params">body, x, v</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Var"</span></span><span> &amp;&amp; body.</span><span><span class="hljs-property">name</span></span><span> === x) </span><span><span class="hljs-keyword">return</span></span><span> v;
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Atom"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> body;
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Sphere"</span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>(body.</span><span><span class="hljs-property">param</span></span><span>, </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">body</span></span><span>, x, v));
  }
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Pop"</span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Pop</span></span><span>(</span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">fn</span></span><span>, x, v), </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">arg</span></span><span>, x, v));
  }
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Merge</span></span><span>(</span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">l</span></span><span>, x, v), </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">r</span></span><span>, x, v));
  }
  </span><span><span class="hljs-keyword">return</span></span><span> body;
}

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">step</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (t.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Pop"</span></span><span> &amp;&amp; t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Sphere"</span></span><span> &amp;&amp; t.</span><span><span class="hljs-property">arg</span></span><span>.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Atom"</span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title function_">substitute</span></span><span>(t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">body</span></span><span>, t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">param</span></span><span>, t.</span><span><span class="hljs-property">arg</span></span><span>);
  }
  </span><span><span class="hljs-keyword">return</span></span><span> t; </span><span><span class="hljs-comment">// trivial fallback</span></span><span>
}

</span><span><span class="hljs-comment">// ----- DOM render -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">renderCircle</span></span><span>(</span><span><span class="hljs-params">term</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> div = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"div"</span></span><span>);
  div.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"circle outer"</span></span><span>;
  </span><span><span class="hljs-keyword">const</span></span><span> span = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"span"</span></span><span>);
