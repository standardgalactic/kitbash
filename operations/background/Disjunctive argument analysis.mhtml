.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-latex"><span><span><span class="hljs-comment">% --- Distribution type former and ops ---</span></span><span>
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Dist-Form]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> A : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>i }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(A) : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>i }
</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Return]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : A }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{return}(a) : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(A) }
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Bind]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mu</span></span><span> : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(A) </span><span><span class="hljs-keyword">\quad</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span>, x{:}A </span><span><span class="hljs-keyword">\vdash</span></span><span> f(x) : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(B) }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{bind}</span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\mu</span></span><span><span class="hljs-keyword">\ </span></span><span>f : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(B) }
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-comment">% --- Probabilities as a base type (as above) ---</span></span><span>
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>0
</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Prob-Const]{}{ </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> p : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} } </span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\text</span></span><span>{(with } p </span><span><span class="hljs-keyword">\in</span></span><span> [0,1]</span><span><span class="hljs-keyword">\text</span></span><span>{)}
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-comment">% --- Typed Choice producing a distribution ---</span></span><span>
</span><span><span class="hljs-keyword">\begin</span></span><span>{mathpar}
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Choice-Dist]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> p : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Choice}(p,t,u) : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(A) }
</span><span><span class="hljs-keyword">\end</span></span><span>{mathpar}

</span><span><span class="hljs-comment">% --- Compatibility shims (optional, handy in proofs/code):</span></span><span>
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Pop-Dist]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> f : A </span><span><span class="hljs-keyword">\to</span></span><span> B </span><span><span class="hljs-keyword">\quad</span></span><span> </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mu</span></span><span> : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(A) }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{bind}</span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\mu</span></span><span><span class="hljs-keyword">\ </span></span><span>(</span><span><span class="hljs-keyword">\lambda</span></span><span> x.</span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\mathsf</span></span><span>{return}(f</span><span><span class="hljs-keyword">\,</span></span><span>x)) : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Dist}(B) }
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-comment">% Operationally, you can view Choice(p,t,u) as a redex that samples to t or u,</span></span><span>
</span><span><span class="hljs-comment">% while denotationally \llbracket \mathrm{Choice}(p,t,u) \rrbracket = p\,\delta_t + (1-p)\,\delta_u.</span></span><span>
</span></span></code></div></div></pre>
<p data-start="3013" data-end="3198"><strong data-start="3013" data-end="3029">When to use:</strong> You want clean <strong data-start="3045" data-end="3072">compositional semantics</strong> (e.g., a probability monad), integration with expectation/aggregation, and easy proofs of adequacy with a denotational model.</p>
<hr data-start="3200" data-end="3203">
<h4 data-start="3205" data-end="3253">Tiny add-on (safe elimination for Option B)</h4>
