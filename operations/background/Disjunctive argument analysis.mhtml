     </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Choice}(p,t,u) </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{probabilistic choice}
