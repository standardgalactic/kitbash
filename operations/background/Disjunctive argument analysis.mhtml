iant="normal">r</mi><mi mathvariant="normal">g</mi><mi mathvariant="normal">e</mi></mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>B</mi></msub><mo separator="true">,</mo><msub><mi>R</mi><mi>C</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mi>W</mi><mn>0</mn><mo stretchy="false">)</mo><mo fence="false" stretchy="true" minsize="1.8em" maxsize="1.8em">)</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">\mathrm{Fold}(\mathrm{Merge}(R_A,\mathrm{Merge}(R_B,R_C)), W0)
