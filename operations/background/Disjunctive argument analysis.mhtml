</span><span><span class="hljs-keyword">\subsection</span></span><span>{Translation </span><span><span class="hljs-keyword">\texorpdfstring</span></span><span>{</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span><span class="hljs-built_in">$</span></span><span>}{Tπ}: Nondeterministic parallel fragment of </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\pi</span></span><span><span class="hljs-built_in">$</span></span><span>-calculus}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Source fragment.}
Processes </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\;</span></span><span>P,Q ::= 0 </span><span><span class="hljs-keyword">\mid</span></span><span> P </span><span><span class="hljs-keyword">\mid</span></span><span> Q </span><span><span class="hljs-keyword">\mid</span></span><span> (</span><span><span class="hljs-keyword">\nu</span></span><span> a)P </span><span><span class="hljs-keyword">\mid</span></span><span> a(x).P </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-keyword">\overline</span></span><span>{a}</span><span><span class="hljs-keyword">\langle</span></span><span> b</span><span><span class="hljs-keyword">\rangle</span></span><span>.P</span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-built_in">$</span></span><span>,
