  </span><span><span class="hljs-selector-class">.popped</span></span><span> { </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">scale</span></span><span>(</span><span><span class="hljs-number">0.1</span></span><span>); </span><span><span class="hljs-attribute">opacity</span></span><span>: </span><span><span class="hljs-number">0</span></span><span>; }
  </span><span><span class="hljs-keyword">@keyframes</span></span><span> shake {
