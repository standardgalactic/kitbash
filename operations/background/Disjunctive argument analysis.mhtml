</span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span>(P </span><span><span class="hljs-keyword">\mid</span></span><span> Q) </span><span><span class="hljs-built_in">&amp;</span></span><span>= </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(</span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span>(P),</span><span><span class="hljs-keyword">\,</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span><span class="hljs-keyword">\pi</span></span><span>(Q)) : O </span><span><span class="hljs-keyword">\\</span></span><span>[3pt]
