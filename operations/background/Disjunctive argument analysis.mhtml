.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-comment"># === spherepop_viz.py ===</span></span><span>
</span><span><span class="hljs-comment"># Visualization + Export utilities for Spherepop Calculus (SPC)</span></span><span>
</span><span><span class="hljs-comment"># Requires: matplotlib, networkx</span></span><span>

</span><span><span class="hljs-keyword">import</span></span><span> json
</span><span><span class="hljs-keyword">import</span></span><span> matplotlib.pyplot </span><span><span class="hljs-keyword">as</span></span><span> plt
</span><span><span class="hljs-keyword">import</span></span><span> networkx </span><span><span class="hljs-keyword">as</span></span><span> nx

</span><span><span class="hljs-keyword">from</span></span><span> spherepop_core </span><span><span class="hljs-keyword">import</span></span><span> Term, to_graph, fold_or, reason_const, reason_prob, merge_many, Atom  </span><span><span class="hljs-comment"># import your interpreter</span></span><span>

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 1) 2D visualization</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">draw_term</span></span><span>(</span><span><span class="hljs-params">term: Term, filename: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"spc_term.png"</span></span><span>):
    </span><span><span class="hljs-string">"""Render an SPC term as a 2D bubble graph with matplotlib."""</span></span><span>
    G = to_graph(term)

    pos = nx.spring_layout(G, seed=</span><span><span class="hljs-number">42</span></span><span>)  </span><span><span class="hljs-comment"># deterministic layout</span></span><span>
    labels = nx.get_node_attributes(G, </span><span><span class="hljs-string">"label"</span></span><span>)

    plt.figure(figsize=(</span><span><span class="hljs-number">8</span></span><span>, </span><span><span class="hljs-number">6</span></span><span>))
    nx.draw(
        G, pos,
        labels=labels,
        with_labels=</span><span><span class="hljs-literal">True</span></span><span>,
        node_size=</span><span><span class="hljs-number">1200</span></span><span>,
        node_color=</span><span><span class="hljs-string">"#a0d8f0"</span></span><span>,
        font_size=</span><span><span class="hljs-number">9</span></span><span>,
        font_weight=</span><span><span class="hljs-string">"bold"</span></span><span>,
        edgecolors=</span><span><span class="hljs-string">"black"</span></span><span>
    )
    plt.title(</span><span><span class="hljs-string">"Spherepop Term Graph"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
    plt.tight_layout()
    plt.savefig(filename)
    plt.show()

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 2) JSON export for 3D engines</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">export_json</span></span><span>(</span><span><span class="hljs-params">term: Term, filename: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"spc_term.json"</span></span><span>):
    </span><span><span class="hljs-string">"""Export an SPC term as a JSON scene graph for external renderers."""</span></span><span>
    G = to_graph(term)
    data = {
        </span><span><span class="hljs-string">"nodes"</span></span><span>: [{</span><span><span class="hljs-string">"id"</span></span><span>: n, </span><span><span class="hljs-string">"label"</span></span><span>: d[</span><span><span class="hljs-string">"label"</span></span><span>]} </span><span><span class="hljs-keyword">for</span></span><span> n, d </span><span><span class="hljs-keyword">in</span></span><span> G.nodes(data=</span><span><span class="hljs-literal">True</span></span><span>)],
        </span><span><span class="hljs-string">"edges"</span></span><span>: [{</span><span><span class="hljs-string">"source"</span></span><span>: u, </span><span><span class="hljs-string">"target"</span></span><span>: v} </span><span><span class="hljs-keyword">for</span></span><span> u, v </span><span><span class="hljs-keyword">in</span></span><span> G.edges()]
    }
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(filename, </span><span><span class="hljs-string">"w"</span></span><span>) </span><span><span class="hljs-keyword">as</span></span><span> f:
        json.dump(data, f, indent=</span><span><span class="hljs-number">2</span></span><span>)
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[+] Exported SPC term graph to <span class="hljs-subst">{filename}</span></span></span><span>")

</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 3) Demo usage</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">if</span></span><span> __name__ == </span><span><span class="hljs-string">"__main__"</span></span><span>:
    </span><span><span class="hljs-comment"># World atom</span></span><span>
    W0 = Atom(</span><span><span class="hljs-string">"W0"</span></span><span>)

    </span><span><span class="hljs-comment"># Example A: Deterministic reasons [Safe, Doom, Safe]</span></span><span>
    R1 = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    R2 = reason_const(</span><span><span class="hljs-string">"Doom"</span></span><span>)
    R3 = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    reasons = merge_many([R1, R2, R3])
    term = fold_or(reasons, W0)

    draw_term(term, </span><span><span class="hljs-string">"doom_graph.png"</span></span><span>)
    export_json(term, </span><span><span class="hljs-string">"doom_graph.json"</span></span><span>)

    </span><span><span class="hljs-comment"># Example B: Probabilistic reasons</span></span><span>
    R4 = reason_prob(</span><span><span class="hljs-number">0.2</span></span><span>)
    R5 = reason_prob(</span><span><span class="hljs-number">0.5</span></span><span>)
    R6 = reason_prob(</span><span><span class="hljs-number">0.05</span></span><span>)
    reasons_p = merge_many([R4, R5, R6])
    term_p = fold_or(reasons_p, W0)

    draw_term(term_p, </span><span><span class="hljs-string">"doom_prob_graph.png"</span></span><span>)
    export_json(term_p, </span><span><span class="hljs-string">"doom_prob_graph.json"</span></span><span>)
</span></span></code></div></div></pre>
