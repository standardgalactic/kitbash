  </span><span><span class="hljs-attr">"nodes"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-attr">"id"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"n0"</span></span><span><span class="hljs-punctuation">,</span></span><span> </span><span><span class="hljs-attr">"label"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"Pop"</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-attr">"id"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"n1"</span></span><span><span class="hljs-punctuation">,</span></span><span> </span><span><span class="hljs-attr">"label"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"Sphere(w)"</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-attr">"id"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"n2"</span></span><span><span class="hljs-punctuation">,</span></span><span> </span><span><span class="hljs-attr">"label"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"Doom"</span></span><span><span class="hljs-punctuation">}</span></span><span>
