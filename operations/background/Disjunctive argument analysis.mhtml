</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">export_json</span></span><span>(</span><span><span class="hljs-params">term: Term, filename=<span class="hljs-string">"spc_term.json"</span></span></span><span>):
