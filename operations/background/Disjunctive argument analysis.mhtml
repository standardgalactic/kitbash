  </span><span><span class="hljs-selector-class">.outer</span></span><span> { </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">200</span></span><span>,</span><span><span class="hljs-number">255</span></span><span>,</span><span><span class="hljs-number">0.15</span></span><span>); }
  </span><span><span class="hljs-selector-class">.middle</span></span><span> { </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">255</span></span><span>,</span><span><span class="hljs-number">150</span></span><span>,</span><span><span class="hljs-number">0.15</span></span><span>); }
  </span><span><span class="hljs-selector-class">.inner</span></span><span> { </span><span><span class="hljs-attribute">background</span></span><span>: </span><span><span class="hljs-built_in">rgba</span></span><span>(</span><span><span class="hljs-number">255</span></span><span>,</span><span><span class="hljs-number">200</span></span><span>,</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">0.15</span></span><span>); }
