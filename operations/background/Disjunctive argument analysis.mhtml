    </span><span><span class="hljs-number">25%</span></span><span> { </span><span><span class="hljs-attribute">transform</span></span><span>: </span><span><span class="hljs-built_in">translateX</span></span><span>(-</span><span><span class="hljs-number">5px</span></span><span>); }
