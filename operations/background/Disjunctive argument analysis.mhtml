     </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mid</span></span><span> </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u) </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{parallel / disjunction} </span><span><span class="hljs-keyword">\\</span></span><span>
