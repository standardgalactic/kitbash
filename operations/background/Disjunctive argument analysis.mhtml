</span><span><span class="hljs-keyword">import</span></span><span> matplotlib.pyplot </span><span><span class="hljs-keyword">as</span></span><span> plt

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">draw_term</span></span><span>(</span><span><span class="hljs-params">term: Term, filename: <span class="hljs-built_in">str</span></span></span><span> = </span><span><span class="hljs-string">"spc_term.png"</span></span><span>):
    G = to_graph(term)

    pos = nx.spring_layout(G, seed=</span><span><span class="hljs-number">42</span></span><span>)  </span><span><span class="hljs-comment"># layout algorithm</span></span><span>

    labels = nx.get_node_attributes(G, </span><span><span class="hljs-string">"label"</span></span><span>)

    plt.figure(figsize=(</span><span><span class="hljs-number">8</span></span><span>, </span><span><span class="hljs-number">6</span></span><span>))
    nx.draw(
        G, pos,
        labels=labels,
        with_labels=</span><span><span class="hljs-literal">True</span></span><span>,
        node_size=</span><span><span class="hljs-number">1200</span></span><span>,
        node_color=</span><span><span class="hljs-string">"#a0d8f0"</span></span><span>,
        font_size=</span><span><span class="hljs-number">9</span></span><span>,
        font_weight=</span><span><span class="hljs-string">"bold"</span></span><span>,
        edgecolors=</span><span><span class="hljs-string">"black"</span></span><span>
    )
    plt.title(</span><span><span class="hljs-string">"Spherepop Term Graph"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
    plt.tight_layout()
    plt.savefig(filename)
    plt.show()


</span><span><span class="hljs-comment"># --- Demo ---</span></span><span>
</span><span><span class="hljs-keyword">if</span></span><span> __name__ == </span><span><span class="hljs-string">"__main__"</span></span><span>:
    </span><span><span class="hljs-comment"># Example: Disjunctive Doom with R1=Safe, R2=Doom, R3=Safe</span></span><span>
    W0 = Atom(</span><span><span class="hljs-string">"W0"</span></span><span>)
    R1 = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    R2 = reason_const(</span><span><span class="hljs-string">"Doom"</span></span><span>)
    R3 = reason_const(</span><span><span class="hljs-string">"Safe"</span></span><span>)
    reasons = merge_many([R1, R2, R3])
    term = fold_or(reasons, W0)

    draw_term(term, </span><span><span class="hljs-string">"doom_graph.png"</span></span><span>)
</span></span></code></div></div></pre>
<h3 data-start="1366" data-end="1384">What this does</h3>
<ul data-start="1385" data-end="1559">
<li data-start="1385" data-end="1444">
<p data-start="1387" data-end="1444">Builds the SPC term for <code data-start="1411" data-end="1443">FoldOr([Safe, Doom, Safe], W0)</code>.</p>
</li>
<li data-start="1445" data-end="1487">
<p data-start="1447" data-end="1487">Converts it to a <strong data-start="1464" data-end="1473">graph</strong> (<code data-start="1475" data-end="1485">to_graph</code>).</p>
</li>
<li data-start="1488" data-end="1530">
<p data-start="1490" data-end="1530">Plots it with <code data-start="1504" data-end="1514">networkx</code> + <code data-start="1517" data-end="1529">matplotlib</code>.</p>
</li>
<li data-start="1531" data-end="1559">
<p data-start="1533" data-end="1559">Saves as <code data-start="1542" data-end="1558">doom_graph.png</code>.</p>
</li>
</ul>
<p data-start="1561" data-end="1572">You’ll see:</p>
<ul data-start="1573" data-end="1772">
<li data-start="1573" data-end="1659">
<p data-start="1575" data-end="1659"><strong data-start="1575" data-end="1591">Blue bubbles</strong> with labels like <code data-start="1609" data-end="1620">Sphere(w)</code>, <code data-start="1622" data-end="1627">Pop</code>, <code data-start="1629" data-end="1636">Merge</code>, <code data-start="1638" data-end="1644">Safe</code>, <code data-start="1646" data-end="1652">Doom</code>, <code data-start="1654" data-end="1658">W0</code>.</p>
</li>
<li data-start="1660" data-end="1731">
<p data-start="1662" data-end="1731">Edges connecting parent → child nodes (e.g. Pop → Sphere, Pop → Arg).</p>
</li>
<li data-start="1732" data-end="1772">
<p data-start="1734" data-end="1772">The disjunctive structure is explicit.</p>
</li>
</ul>
<hr data-start="1774" data-end="1777">
