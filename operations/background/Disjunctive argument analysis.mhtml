</span></span><span><span class="hljs-comment">// ----- SPC constructors -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Atom</span></span><span>(</span><span><span class="hljs-params">val</span></span><span>) { </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-attr">tag</span></span><span>: </span><span><span class="hljs-string">"Atom"</span></span><span>, val }; }
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Sphere</span></span><span>(</span><span><span class="hljs-params">param, body</span></span><span>) { </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-attr">tag</span></span><span>: </span><span><span class="hljs-string">"Sphere"</span></span><span>, param, body }; }
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Pop</span></span><span>(</span><span><span class="hljs-params">fn, arg</span></span><span>) { </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-attr">tag</span></span><span>: </span><span><span class="hljs-string">"Pop"</span></span><span>, fn, arg }; }
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Merge</span></span><span>(</span><span><span class="hljs-params">l, r</span></span><span>) { </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-attr">tag</span></span><span>: </span><span><span class="hljs-string">"Merge"</span></span><span>, l, r }; }

</span><span><span class="hljs-comment">// ----- Pretty printer -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">pp</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">switch</span></span><span>(t.</span><span><span class="hljs-property">tag</span></span><span>) {
    </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">"Atom"</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> t.</span><span><span class="hljs-property">val</span></span><span>;
    </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">"Sphere"</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">"Sphere("</span></span><span> + t.</span><span><span class="hljs-property">param</span></span><span> + </span><span><span class="hljs-string">")"</span></span><span>;
    </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">"Pop"</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">"Pop("</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(t.</span><span><span class="hljs-property">fn</span></span><span>) + </span><span><span class="hljs-string">","</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(t.</span><span><span class="hljs-property">arg</span></span><span>) + </span><span><span class="hljs-string">")"</span></span><span>;
    </span><span><span class="hljs-keyword">case</span></span><span> </span><span><span class="hljs-string">"Merge"</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">"Merge("</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(t.</span><span><span class="hljs-property">l</span></span><span>) + </span><span><span class="hljs-string">","</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(t.</span><span><span class="hljs-property">r</span></span><span>) + </span><span><span class="hljs-string">")"</span></span><span>;
  }
}

</span><span><span class="hljs-comment">// ----- One-step β-reduction -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">substitute</span></span><span>(</span><span><span class="hljs-params">body, x, v</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Atom"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> body;
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Sphere"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>(body.</span><span><span class="hljs-property">param</span></span><span>, </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">body</span></span><span>, x, v));
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Pop"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Pop</span></span><span>(</span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">fn</span></span><span>, x, v), </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">arg</span></span><span>, x, v));
  </span><span><span class="hljs-keyword">if</span></span><span> (body.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Merge</span></span><span>(</span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">l</span></span><span>, x, v), </span><span><span class="hljs-title function_">substitute</span></span><span>(body.</span><span><span class="hljs-property">r</span></span><span>, x, v));
  </span><span><span class="hljs-keyword">return</span></span><span> body;
}
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">step</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (t.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Pop"</span></span><span> &amp;&amp; t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Sphere"</span></span><span> &amp;&amp; t.</span><span><span class="hljs-property">arg</span></span><span>.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Atom"</span></span><span>) {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title function_">substitute</span></span><span>(t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">body</span></span><span>, t.</span><span><span class="hljs-property">fn</span></span><span>.</span><span><span class="hljs-property">param</span></span><span>, t.</span><span><span class="hljs-property">arg</span></span><span>);
  }
  </span><span><span class="hljs-keyword">return</span></span><span> t; </span><span><span class="hljs-comment">// fallback</span></span><span>
}

</span><span><span class="hljs-comment">// ----- Render SPC term recursively -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">renderCircle</span></span><span>(</span><span><span class="hljs-params">term, level=<span class="hljs-string">"outer"</span></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> div = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"div"</span></span><span>);
  div.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"circle "</span></span><span> + level;

  </span><span><span class="hljs-keyword">const</span></span><span> span = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"span"</span></span><span>);
  span.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"text"</span></span><span>;
  span.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-title function_">pp</span></span><span>(term);
  div.</span><span><span class="hljs-title function_">appendChild</span></span><span>(span);

  </span><span><span class="hljs-comment">// Recursive children for Merge</span></span><span>
  </span><span><span class="hljs-keyword">if</span></span><span> (term.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) {
    div.</span><span><span class="hljs-title function_">appendChild</span></span><span>(</span><span><span class="hljs-title function_">renderCircle</span></span><span>(term.</span><span><span class="hljs-property">l</span></span><span>, </span><span><span class="hljs-string">"middle"</span></span><span>));
    div.</span><span><span class="hljs-title function_">appendChild</span></span><span>(</span><span><span class="hljs-title function_">renderCircle</span></span><span>(term.</span><span><span class="hljs-property">r</span></span><span>, </span><span><span class="hljs-string">"middle"</span></span><span>));
  }

  </span><span><span class="hljs-comment">// On click: try to reduce</span></span><span>
  div.</span><span><span class="hljs-property">onclick</span></span><span> = </span><span><span class="hljs-function">(<span class="hljs-params">e</span></span></span><span>) =&gt; {
    e.</span><span><span class="hljs-title function_">stopPropagation</span></span><span>();
    </span><span><span class="hljs-keyword">const</span></span><span> reduced = </span><span><span class="hljs-title function_">step</span></span><span>(term);
    </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-title function_">pp</span></span><span>(reduced) !== </span><span><span class="hljs-title function_">pp</span></span><span>(term)) {
      div.</span><span><span class="hljs-property">classList</span></span><span>.</span><span><span class="hljs-title function_">add</span></span><span>(</span><span><span class="hljs-string">"popped"</span></span><span>);
      </span><span><span class="hljs-built_in">setTimeout</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
        div.</span><span><span class="hljs-property">innerHTML</span></span><span> = </span><span><span class="hljs-string">"&lt;span class='text'&gt;"</span></span><span> + </span><span><span class="hljs-title function_">pp</span></span><span>(reduced) + </span><span><span class="hljs-string">"&lt;/span&gt;"</span></span><span>;
      }, </span><span><span class="hljs-number">300</span></span><span>);
    } </span><span><span class="hljs-keyword">else</span></span><span> {
      div.</span><span><span class="hljs-property">style</span></span><span>.</span><span><span class="hljs-property">animation</span></span><span> = </span><span><span class="hljs-string">"shake 0.5s"</span></span><span>;
      </span><span><span class="hljs-built_in">setTimeout</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> { div.</span><span><span class="hljs-property">style</span></span><span>.</span><span><span class="hljs-property">animation</span></span><span> = </span><span><span class="hljs-string">""</span></span><span>; }, </span><span><span class="hljs-number">500</span></span><span>);
    }
  };

  </span><span><span class="hljs-keyword">return</span></span><span> div;
}

</span><span><span class="hljs-comment">// ----- Demo term: Merge(Sphere(x. Doom), Atom(Safe)) -----</span></span><span>
</span><span><span class="hljs-keyword">const</span></span><span> term = </span><span><span class="hljs-title class_">Merge</span></span><span>(
  </span><span><span class="hljs-title class_">Sphere</span></span><span>(</span><span><span class="hljs-string">"x"</span></span><span>, </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Doom"</span></span><span>)),
  </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Safe"</span></span><span>)
);

</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"viz"</span></span><span>).</span><span><span class="hljs-title function_">appendChild</span></span><span>(</span><span><span class="hljs-title function_">renderCircle</span></span><span>(term));
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">body</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">html</span></span></span><span>&gt;
</span></span></code></div></div></pre>
<hr data-start="3514" data-end="3517">
<h3 data-start="3519" data-end="3535">How it looks</h3>
<ul data-start="3536" data-end="3751">
<li data-start="3536" data-end="3610">
<p data-start="3538" data-end="3610">Each <strong data-start="3543" data-end="3552">Merge</strong> node becomes a circle containing <strong data-start="3586" data-end="3607">two child circles</strong>.</p>
</li>
<li data-start="3611" data-end="3751">
<p data-start="3613" data-end="3664">You can click a bubble to try a <strong data-start="3645" data-end="3663">reduction step</strong>:</p>
<ul data-start="3667" data-end="3751">
<li data-start="3667" data-end="3716">
<p data-start="3669" data-end="3716">If reducible, it pops → shrinks → updates text.</p>
</li>
<li data-start="3719" data-end="3751">
<p data-start="3721" data-end="3751">If not reducible, it shakes.</p>
</li>
</ul>
</li>
</ul>
<hr data-start="3753" data-end="3756">
<p data-start="3758" data-end="4032" data-is-last-node="" data-is-only-node="">Would you like me to extend this further so that <strong data-start="3807" data-end="3846"><code data-start="3809" data-end="3816">Merge</code> with more than two children</strong> (like <code data-start="3853" data-end="3879">Merge(R1, Merge(R2, R3))</code>) automatically <strong data-start="3895" data-end="3946">flattens into a row of multiple sibling bubbles</strong> instead of binary nesting? That would make larger SPC terms much easier to visualize.</p></div></div></div></div><div class="flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.