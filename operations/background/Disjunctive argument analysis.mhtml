01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-latex"><span><span><span class="hljs-comment">% --- New base type for probabilities ---</span></span><span>
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Type}</span><span><span class="hljs-built_in">_</span></span><span>0
</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Prob-Const]{}{ </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> p : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} } </span><span><span class="hljs-keyword">\ </span></span><span><span class="hljs-keyword">\text</span></span><span>{(for any real } p </span><span><span class="hljs-keyword">\in</span></span><span> [0,1]</span><span><span class="hljs-keyword">\text</span></span><span>{)}
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-comment">% --- Typing rule for Choice: both branches same type A ---</span></span><span>
</span><span><span class="hljs-keyword">\begin</span></span><span>{mathpar}
</span><span><span class="hljs-keyword">\inferrule</span></span><span>*[right=Choice]
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> p : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Prob} </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> u : A }
  { </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Choice}(p,t,u) : A }
</span><span><span class="hljs-keyword">\end</span></span><span>{mathpar}

</span><span><span class="hljs-comment">% (Reduction already given)</span></span><span>
</span><span><span class="hljs-comment">% Choice(p,t,u) -&gt; t with prob p; Choice(p,t,u) -&gt; u with prob 1-p</span></span><span>

</span><span><span class="hljs-comment">% Optional meta-theory note (informal):</span></span><span>
</span><span><span class="hljs-comment">% Subject reduction holds: if Γ ⊢ Choice(p,t,u) : A and it reduces to t or u,</span></span><span>
</span><span><span class="hljs-comment">% each has type A, so typing is preserved.</span></span><span>
</span></span></code></div></div></pre>
<p data-start="1369" data-end="1530"><strong data-start="1369" data-end="1385">When to use:</strong> You want to keep SPC as a single typed core (no effect types), and you’re okay with treating probability as an internal, operational phenomenon.</p>
