</span><span><span class="hljs-keyword">\big</span></span><span>(1{+}1,</span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-keyword">\mathsf</span></span><span>{concat}(</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Vec}(1),</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Vec}(1))</span><span><span class="hljs-keyword">\big</span></span><span>)
</span><span><span class="hljs-built_in">&amp;</span></span><span> (1-p)</span><span><span class="hljs-keyword">\,</span></span><span>q </span><span><span class="hljs-keyword">\\</span></span><span>[2pt]
</span><span><span class="hljs-keyword">\big</span></span><span>(1{+}2,</span><span><span class="hljs-keyword">\;</span></span><span><span class="hljs-keyword">\mathsf</span></span><span>{concat}(</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Vec}(1),</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Vec}(2))</span><span><span class="hljs-keyword">\big</span></span><span>)
</span><span><span class="hljs-built_in">&amp;</span></span><span> (1-p)</span><span><span class="hljs-keyword">\,</span></span><span>(1-q)
</span><span><span class="hljs-keyword">\end</span></span><span>{array}
