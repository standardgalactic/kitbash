}

</span><span><span class="hljs-comment">// ----- Full normalization -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">normalize</span></span><span>(</span><span><span class="hljs-params">t, depth=<span class="hljs-number">100</span></span></span><span>) {
  </span><span><span class="hljs-keyword">let</span></span><span> cur = t;
  </span><span><span class="hljs-keyword">for</span></span><span> (</span><span><span class="hljs-keyword">let</span></span><span> i = </span><span><span class="hljs-number">0</span></span><span>; i &lt; depth; i++) {
    </span><span><span class="hljs-keyword">const</span></span><span> reduced = </span><span><span class="hljs-title function_">step</span></span><span>(cur);
    </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-title function_">pp</span></span><span>(reduced) === </span><span><span class="hljs-title function_">pp</span></span><span>(cur)) </span><span><span class="hljs-keyword">return</span></span><span> cur; </span><span><span class="hljs-comment">// no change</span></span><span>
    cur = reduced;
  }
  </span><span><span class="hljs-keyword">return</span></span><span> cur;
}

</span><span><span class="hljs-comment">// ----- Find one reducible subterm -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">findStep</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> reduced = </span><span><span class="hljs-title function_">step</span></span><span>(t);
  </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-title function_">pp</span></span><span>(reduced) !== </span><span><span class="hljs-title function_">pp</span></span><span>(t)) </span><span><span class="hljs-keyword">return</span></span><span> reduced;
  </span><span><span class="hljs-keyword">if</span></span><span> (t.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) {
    </span><span><span class="hljs-keyword">const</span></span><span> l = </span><span><span class="hljs-title function_">findStep</span></span><span>(t.</span><span><span class="hljs-property">l</span></span><span>);
    </span><span><span class="hljs-keyword">if</span></span><span> (l) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Merge</span></span><span>(l, t.</span><span><span class="hljs-property">r</span></span><span>);
    </span><span><span class="hljs-keyword">const</span></span><span> r = </span><span><span class="hljs-title function_">findStep</span></span><span>(t.</span><span><span class="hljs-property">r</span></span><span>);
    </span><span><span class="hljs-keyword">if</span></span><span> (r) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Merge</span></span><span>(t.</span><span><span class="hljs-property">l</span></span><span>, r);
  }
  </span><span><span class="hljs-keyword">if</span></span><span> (t.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Pop"</span></span><span>) {
    </span><span><span class="hljs-keyword">const</span></span><span> f = </span><span><span class="hljs-title function_">findStep</span></span><span>(t.</span><span><span class="hljs-property">fn</span></span><span>);
    </span><span><span class="hljs-keyword">if</span></span><span> (f) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Pop</span></span><span>(f, t.</span><span><span class="hljs-property">arg</span></span><span>);
    </span><span><span class="hljs-keyword">const</span></span><span> a = </span><span><span class="hljs-title function_">findStep</span></span><span>(t.</span><span><span class="hljs-property">arg</span></span><span>);
    </span><span><span class="hljs-keyword">if</span></span><span> (a) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">Pop</span></span><span>(t.</span><span><span class="hljs-property">fn</span></span><span>, a);
  }
  </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">null</span></span><span>;
}

</span><span><span class="hljs-comment">// ----- Flatten Merge into list -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">flattenMerge</span></span><span>(</span><span><span class="hljs-params">t</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (t.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> [...</span><span><span class="hljs-title function_">flattenMerge</span></span><span>(t.</span><span><span class="hljs-property">l</span></span><span>), ...</span><span><span class="hljs-title function_">flattenMerge</span></span><span>(t.</span><span><span class="hljs-property">r</span></span><span>)];
  </span><span><span class="hljs-keyword">return</span></span><span> [t];
}

</span><span><span class="hljs-comment">// ----- Render SPC term recursively -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">renderCircle</span></span><span>(</span><span><span class="hljs-params">term, level=<span class="hljs-string">"outer"</span></span></span><span>, onUpdateGlobal=()=&gt;{}) {
  </span><span><span class="hljs-keyword">const</span></span><span> div = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"div"</span></span><span>);
  div.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"circle "</span></span><span> + level;

  </span><span><span class="hljs-keyword">const</span></span><span> span = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"span"</span></span><span>);
  span.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"text"</span></span><span>;
  span.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-title function_">pp</span></span><span>(term);
  div.</span><span><span class="hljs-title function_">appendChild</span></span><span>(span);

  </span><span><span class="hljs-keyword">if</span></span><span> (term.</span><span><span class="hljs-property">tag</span></span><span> === </span><span><span class="hljs-string">"Merge"</span></span><span>) {
    </span><span><span class="hljs-keyword">const</span></span><span> container = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">createElement</span></span><span>(</span><span><span class="hljs-string">"div"</span></span><span>);
    container.</span><span><span class="hljs-property">className</span></span><span> = </span><span><span class="hljs-string">"merge-children"</span></span><span>;
    </span><span><span class="hljs-keyword">const</span></span><span> children = </span><span><span class="hljs-title function_">flattenMerge</span></span><span>(term);
    children.</span><span><span class="hljs-title function_">forEach</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">child, idx</span></span></span><span>) =&gt; {
      container.</span><span><span class="hljs-title function_">appendChild</span></span><span>(
        </span><span><span class="hljs-title function_">renderCircle</span></span><span>(child, </span><span><span class="hljs-string">"middle"</span></span><span>, </span><span><span class="hljs-function">(<span class="hljs-params">newChild</span></span></span><span>) =&gt; {
          children[idx] = newChild;
          </span><span><span class="hljs-keyword">const</span></span><span> newTerm = children.</span><span><span class="hljs-title function_">reduce</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">acc, cur</span></span></span><span>) =&gt; </span><span><span class="hljs-title class_">Merge</span></span><span>(acc, cur));
          span.</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-title function_">pp</span></span><span>(newTerm);
          </span><span><span class="hljs-title function_">onUpdateGlobal</span></span><span>(newTerm);
        })
      );
    });
    div.</span><span><span class="hljs-title function_">appendChild</span></span><span>(container);
  }

  div.</span><span><span class="hljs-property">onclick</span></span><span> = </span><span><span class="hljs-function">(<span class="hljs-params">e</span></span></span><span>) =&gt; {
    e.</span><span><span class="hljs-title function_">stopPropagation</span></span><span>();
    </span><span><span class="hljs-keyword">const</span></span><span> reduced = </span><span><span class="hljs-title function_">step</span></span><span>(term);
    </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-title function_">pp</span></span><span>(reduced) !== </span><span><span class="hljs-title function_">pp</span></span><span>(term)) {
      div.</span><span><span class="hljs-property">classList</span></span><span>.</span><span><span class="hljs-title function_">add</span></span><span>(</span><span><span class="hljs-string">"popped"</span></span><span>);
      </span><span><span class="hljs-built_in">setTimeout</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> { </span><span><span class="hljs-title function_">onUpdateGlobal</span></span><span>(reduced); }, </span><span><span class="hljs-number">200</span></span><span>);
    }
  };

  </span><span><span class="hljs-keyword">return</span></span><span> div;
}

</span><span><span class="hljs-comment">// ----- Top-level manager -----</span></span><span>
</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">renderRoot</span></span><span>(</span><span><span class="hljs-params">term, container</span></span><span>) {
  container.</span><span><span class="hljs-property">innerHTML</span></span><span> = </span><span><span class="hljs-string">""</span></span><span>;
  </span><span><span class="hljs-keyword">const</span></span><span> rootDiv = </span><span><span class="hljs-title function_">renderCircle</span></span><span>(term, </span><span><span class="hljs-string">"outer"</span></span><span>, </span><span><span class="hljs-function">(<span class="hljs-params">newTerm</span></span></span><span>) =&gt; {
    </span><span><span class="hljs-title function_">renderRoot</span></span><span>(newTerm, container);
  });
  container.</span><span><span class="hljs-title function_">appendChild</span></span><span>(rootDiv);

  </span><span><span class="hljs-comment">// Step All</span></span><span>
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"stepAll"</span></span><span>).</span><span><span class="hljs-property">onclick</span></span><span> = </span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> normalized = </span><span><span class="hljs-title function_">normalize</span></span><span>(term);
    </span><span><span class="hljs-title function_">renderRoot</span></span><span>(normalized, container);
  };

  </span><span><span class="hljs-comment">// Animate All</span></span><span>
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"animateAll"</span></span><span>).</span><span><span class="hljs-property">onclick</span></span><span> = </span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">let</span></span><span> current = term;
    </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">tick</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
      </span><span><span class="hljs-keyword">const</span></span><span> next = </span><span><span class="hljs-title function_">findStep</span></span><span>(current);
      </span><span><span class="hljs-keyword">if</span></span><span> (next) {
        current = next;
        </span><span><span class="hljs-title function_">renderRoot</span></span><span>(current, container);
        </span><span><span class="hljs-built_in">setTimeout</span></span><span>(tick, </span><span><span class="hljs-built_in">parseInt</span></span><span>(</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"speed"</span></span><span>).</span><span><span class="hljs-property">value</span></span><span>));
      }
    }
    </span><span><span class="hljs-title function_">tick</span></span><span>();
  };
}

</span><span><span class="hljs-comment">// ----- Speed slider label -----</span></span><span>
</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"speed"</span></span><span>).</span><span><span class="hljs-title function_">addEventListener</span></span><span>(</span><span><span class="hljs-string">"input"</span></span><span>, </span><span><span class="hljs-function">(<span class="hljs-params">e</span></span></span><span>) =&gt; {
  </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"speedLabel"</span></span><span>).</span><span><span class="hljs-property">textContent</span></span><span> = e.</span><span><span class="hljs-property">target</span></span><span>.</span><span><span class="hljs-property">value</span></span><span> + </span><span><span class="hljs-string">" ms"</span></span><span>;
});

</span><span><span class="hljs-comment">// ----- Demo term -----</span></span><span>
</span><span><span class="hljs-keyword">const</span></span><span> term = </span><span><span class="hljs-title class_">Merge</span></span><span>(
  </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Safe"</span></span><span>),
  </span><span><span class="hljs-title class_">Merge</span></span><span>(
    </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Doom"</span></span><span>),
    </span><span><span class="hljs-title class_">Merge</span></span><span>(
      </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Safe"</span></span><span>),
      </span><span><span class="hljs-title class_">Pop</span></span><span>(</span><span><span class="hljs-title class_">Sphere</span></span><span>(</span><span><span class="hljs-string">"x"</span></span><span>, </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Doom"</span></span><span>)), </span><span><span class="hljs-title class_">Atom</span></span><span>(</span><span><span class="hljs-string">"Safe"</span></span><span>))
    )
  )
);

</span><span><span class="hljs-title function_">renderRoot</span></span><span>(term, </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"viz"</span></span><span>));
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">body</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">html</span></span></span><span>&gt;
</span></span></code></div></div></pre>
