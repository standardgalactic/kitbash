t </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{with prob.</span><span><span class="hljs-keyword">\ </span></span><span>} p </span><span><span class="hljs-keyword">\\</span></span><span>
u </span><span><span class="hljs-built_in">&amp;</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{with prob.</span><span><span class="hljs-keyword">\ </span></span><span>} 1-p
</span><span><span class="hljs-keyword">\end</span></span><span>{cases}
</span><span><span class="hljs-keyword">\end</span></span><span>{align*}

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u) </span><span><span class="hljs-keyword">\equiv</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(u,t),
</span><span><span class="hljs-keyword">\quad</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(u,v)) </span><span><span class="hljs-keyword">\equiv</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Merge}(t,u),v)
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Categorical Semantics}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Monoidal Functorial Semantics.}
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\mathrm</span></span><span>{Pop} : </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere} </span><span><span class="hljs-keyword">\to</span></span><span> [</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Field}, </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Field}]
</span><span><span class="hljs-keyword">\]</span></span><span>
is a monoidal functor, preserving tensor products, the unit, and coherence isomorphisms.

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{2-Category </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere}</span><span><span class="hljs-built_in">^</span></span><span>2</span><span><span class="hljs-built_in">$</span></span><span>.}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> 0-cells: regions </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Omega</span></span><span> </span><span><span class="hljs-keyword">\subseteq</span></span><span> </span><span><span class="hljs-keyword">\mathbb</span></span><span>{R}</span><span><span class="hljs-built_in">^</span></span><span>n</span><span><span class="hljs-built_in">$</span></span><span>
</span><span><span class="hljs-keyword">\item</span></span><span> 1-cells: spheres (supports with morphism data)
</span><span><span class="hljs-keyword">\item</span></span><span> 2-cells: natural transformations </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\tau</span></span><span> : </span><span><span class="hljs-keyword">\sigma</span></span><span><span class="hljs-built_in">_</span></span><span>1 </span><span><span class="hljs-keyword">\Rightarrow</span></span><span> </span><span><span class="hljs-keyword">\sigma</span></span><span><span class="hljs-built_in">_</span></span><span>2</span><span><span class="hljs-built_in">$</span></span><span>
</span><span><span class="hljs-keyword">\item</span></span><span> Composition: horizontal, vertical; strict 2-category axioms
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Topos Semantics.}
Presheaves </span><span><span class="hljs-built_in">$</span></span><span>[</span><span><span class="hljs-keyword">\mathsf</span></span><span>{Sphere}</span><span><span class="hljs-built_in">^</span></span><span>{op}, </span><span><span class="hljs-keyword">\mathsf</span></span><span>{Set}]</span><span><span class="hljs-built_in">$</span></span><span> form a topos, with:
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> Subobject classifier (truth sphere)
</span><span><span class="hljs-keyword">\item</span></span><span> Finite limits and colimits
</span><span><span class="hljs-keyword">\item</span></span><span> Exponentials
</span><span><span class="hljs-keyword">\item</span></span><span> Internal intuitionistic higher-order logic (propositions = subspheres, proofs = morphisms preserving truth)
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Soundness}

</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> Typing judgments </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A</span><span><span class="hljs-built_in">$</span></span><span> interpreted as morphisms in the presheaf topos.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\beta</span></span><span><span class="hljs-built_in">$</span></span><span>-reduction corresponds to naturality of evaluation morphisms.
</span><span><span class="hljs-keyword">\item</span></span><span> Merge corresponds to the tensor product in the monoidal structure.
</span><span><span class="hljs-keyword">\item</span></span><span> Choice corresponds to either internal probabilistic enrichment (Option A) or distribution monad semantics (Option B).
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Theorem (Subject Reduction).}
If </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t : A</span><span><span class="hljs-built_in">$</span></span><span> and </span><span><span class="hljs-built_in">$</span></span><span>t </span><span><span class="hljs-keyword">\to</span></span><span> t'</span><span><span class="hljs-built_in">$</span></span><span>, then </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> t' : A</span><span><span class="hljs-built_in">$</span></span><span>.

</span></span></code></div></div></pre>
