</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.1 Stimuli and Experimental Design}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Stimulus Types:}
  </span><span><span class="hljs-keyword">\begin</span></span><span>{enumerate}
    </span><span><span class="hljs-keyword">\item</span></span><span> Recognition-first: picture‚Äìword and word‚Äìdefinition matches (50</span><span><span class="hljs-keyword">\%</span></span><span> repeats).
    </span><span><span class="hljs-keyword">\item</span></span><span> Prediction-first control: syntactic cloze with low semantic load.
    </span><span><span class="hljs-keyword">\item</span></span><span> Ambiguity: garden-path sentences; semantic illusions (``the pine barked'').
  </span><span><span class="hljs-keyword">\end</span></span><span>{enumerate}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Timing:} fixation 500</span><span><span class="hljs-keyword">\,</span></span><span>ms; stimulus 600</span><span><span class="hljs-keyword">\,</span></span><span>ms; jittered ISI 900--1400</span><span><span class="hljs-keyword">\,</span></span><span>ms; response window 1500</span><span><span class="hljs-keyword">\,</span></span><span>ms.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Repetitions:} 120 trials/condition; total </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\approx</span></span><span><span class="hljs-built_in">$</span></span><span>360--480 trials; counterbalanced lists.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Behavioral Markers:} button press at recognition; confidence (Likert 1--5) post-trial.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Randomization:} Latin-square across lists; no immediate repeats within 3 trials.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.2 EEG/MEG Acquisition </span><span><span class="hljs-keyword">\&amp;</span></span><span> Preprocessing Defaults}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Hardware:} EEG 64/128 channels @ 1</span><span><span class="hljs-keyword">\,</span></span><span>kHz (Ag/AgCl), MEG whole-head @ 1.2</span><span><span class="hljs-keyword">\,</span></span><span>kHz.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Filters:} 1--150</span><span><span class="hljs-keyword">\,</span></span><span>Hz band-pass; notch at line frequency; zero-phase FIR.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{ICA:} remove blink/ECG (run high-pass 1</span><span><span class="hljs-keyword">\,</span></span><span>Hz for ICA fit; apply to 0.1</span><span><span class="hljs-keyword">\,</span></span><span>Hz data if used).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Epoching:} </span><span><span class="hljs-built_in">$</span></span><span>[-1.0, 2.5]</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\,</span></span><span>s around stimulus onset; baseline </span><span><span class="hljs-built_in">$</span></span><span>[-0.5, -0.1]</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\,</span></span><span>s.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Source Space:} individual MRI or template head model; ROIs: MTG/AG, IFG(BA44/45), SMA.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Leakage Control:} symmetric orthogonalization or SSBL before inter-ROI metrics.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.3 fMRI Acquisition </span><span><span class="hljs-keyword">\&amp;</span></span><span> Preprocessing Defaults}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Scanner:} 3T/7T, multiband EPI; TR 600--800</span><span><span class="hljs-keyword">\,</span></span><span>ms; TE </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\sim</span></span><span><span class="hljs-built_in">$</span></span><span>30</span><span><span class="hljs-keyword">\,</span></span><span>ms; voxel 2--2.5</span><span><span class="hljs-keyword">\,</span></span><span>mm.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Preproc:} fMRIPrep (motion/physio regressors); 0.008--0.25</span><span><span class="hljs-keyword">\,</span></span><span>Hz temporal filter.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Parcellation:} Schaefer-400 + explicit MTG/AG/IFG/SMA/HPC/MD Thal/Cereb ROIs.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{DynConn:} 60</span><span><span class="hljs-keyword">\,</span></span><span>s sliding window (30</span><span><span class="hljs-keyword">\,</span></span><span>s step) for HMM/GC/DCM; z-score time series per run.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.4 Analysis Parameter Presets}
</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Cross-Frequency Coupling (EEG/MEG)}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Bands:} </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\theta</span></span><span><span class="hljs-built_in">$</span></span><span> 4--8</span><span><span class="hljs-keyword">\,</span></span><span>Hz (Hilbert phase), </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\gamma</span></span><span><span class="hljs-built_in">$</span></span><span> 30--80</span><span><span class="hljs-keyword">\,</span></span><span>Hz (Hilbert amplitude).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Windows:} 500</span><span><span class="hljs-keyword">\,</span></span><span>ms, 50</span><span><span class="hljs-keyword">\%</span></span><span> overlap; MI (Tort/Canolty), surrogate testing (200 shuffles).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Connectivity:} PLV/wPLI (</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\theta</span></span><span><span class="hljs-built_in">$</span></span><span>) between MTG</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\leftrightarrow</span></span><span><span class="hljs-built_in">$</span></span><span>IFG; correct with circular stats.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Entropy Proxies (fMRI)}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Time-series Entropy:} SampEn(m{=}2, r{=}0.2</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\sigma</span></span><span><span class="hljs-built_in">$</span></span><span>); PermEn (order 3--5).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Complexity:} LZc on binarized (median) series (segment length </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\ge</span></span><span><span class="hljs-built_in">$</span></span><span> 300 samples).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Graph Entropy:} sliding-window corr graphs; Shannon entropy of degree distribution; von Neumann entropy from Laplacian spectrum.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{Directed Connectivity / Torsion Proxy}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Method:} spectral Granger or DCM; torsion proxy </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{T}</span><span><span class="hljs-built_in">_</span></span><span>{</span><span><span class="hljs-keyword">\mathrm</span></span><span>{fMRI}}(t) = </span><span><span class="hljs-keyword">\frac</span></span><span>{1}{E}</span><span><span class="hljs-keyword">\sum</span></span><span> |GC</span><span><span class="hljs-built_in">_</span></span><span>{i</span><span><span class="hljs-keyword">\to</span></span><span> j}-GC</span><span><span class="hljs-built_in">_</span></span><span>{j</span><span><span class="hljs-keyword">\to</span></span><span> i}|</span><span><span class="hljs-built_in">$</span></span><span>.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Stats:} cluster-based permutation for time-resolved contrasts; FDR within ROIs.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.5 CLIO Telemetry Hooks (LLM)}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Per-pass logs (</span><span><span class="hljs-built_in">$</span></span><span>k</span><span><span class="hljs-built_in">$</span></span><span>):} 
  </span><span><span class="hljs-built_in">$</span></span><span>U</span><span><span class="hljs-built_in">_</span></span><span>k=</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-keyword">\mathbf</span></span><span>{v}</span><span><span class="hljs-built_in">_</span></span><span>k-</span><span><span class="hljs-keyword">\mathcal</span></span><span>{R}[</span><span><span class="hljs-keyword">\Phi</span></span><span><span class="hljs-built_in">_</span></span><span>k,S</span><span><span class="hljs-built_in">_</span></span><span>k]</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-built_in">^</span></span><span>2 + </span><span><span class="hljs-keyword">\lambda</span></span><span><span class="hljs-keyword">\|</span></span><span>S</span><span><span class="hljs-built_in">_</span></span><span>k-S</span><span><span class="hljs-built_in">^</span></span><span><span class="hljs-keyword">\ast</span></span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-built_in">^</span></span><span>2</span><span><span class="hljs-built_in">$</span></span><span>;
  plan graph size; belief entropy (Shannon over node weights); self-reported confidence; wall time.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Oscillation Fit:} damped sinusoid on </span><span><span class="hljs-built_in">$</span></span><span>U</span><span><span class="hljs-built_in">_</span></span><span>k</span><span><span class="hljs-built_in">$</span></span><span>; report </span><span><span class="hljs-built_in">$</span></span><span>(A,</span><span><span class="hljs-keyword">\zeta</span></span><span>,</span><span><span class="hljs-keyword">\omega</span></span><span>,</span><span><span class="hljs-keyword">\phi</span></span><span>,C)</span><span><span class="hljs-built_in">$</span></span><span> and </span><span><span class="hljs-built_in">$</span></span><span>Q=</span><span><span class="hljs-keyword">\tfrac</span></span><span>{1}{2</span><span><span class="hljs-keyword">\zeta</span></span><span>}</span><span><span class="hljs-built_in">$</span></span><span>.
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Intervention Triggers:} </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Delta</span></span><span> U</span><span><span class="hljs-built_in">_</span></span><span>k &gt; </span><span><span class="hljs-keyword">\theta</span></span><span><span class="hljs-built_in">_</span></span><span>U</span><span><span class="hljs-built_in">$</span></span><span> or instantaneous frequency jump </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Rightarrow</span></span><span><span class="hljs-built_in">$</span></span><span> re-plan (graph prune or strategy switch).
</span><span><span class="hljs-keyword">\item</span></span><span> </span><span><span class="hljs-keyword">\textbf</span></span><span>{Alignment Marks:} write event markers for proposal, evaluation, prune, finalization; export CSV/Parquet.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.6 Minimal Code Skeletons (Pseudocode)}
</span><span><span class="hljs-keyword">\paragraph</span></span><span>{PAC (Python/MNE-style)}
</span><span><span class="hljs-keyword">\begin</span></span><span>{verbatim}<span class="hljs-string">
theta = bandpass(raw, 4, 8); gamma = bandpass(raw, 30, 80)
phi = angle(hilbert(theta)); amp = abs(hilbert(gamma))
MI = mod_index(phi, amp, n_bins=18, surrogates=200)  # Tort/Canolty
</span></span><span><span class="hljs-keyword">\end</span></span><span>{verbatim}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{PLV / wPLI}
</span><span><span class="hljs-keyword">\begin</span></span><span>{verbatim}<span class="hljs-string">
phi_i, phi_j = phase(roi_i_theta), phase(roi_j_theta)
PLV = np.abs(np.mean(np.exp(1j*(phi_i - phi_j))))
wPLI = debiased_wpli(roi_i_theta, roi_j_theta)
</span></span><span><span class="hljs-keyword">\end</span></span><span>{verbatim}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{fMRI Sample Entropy}
</span><span><span class="hljs-keyword">\begin</span></span><span>{verbatim}<span class="hljs-string">
def sampen(x, m=2, r=0.2*np.std(x)): 
    # count template matches length m and m+1; return -log(A/B)
</span></span><span><span class="hljs-keyword">\end</span></span><span>{verbatim}

</span><span><span class="hljs-keyword">\paragraph</span></span><span>{CLIO Uncertainty Fit}
</span><span><span class="hljs-keyword">\begin</span></span><span>{verbatim}<span class="hljs-string">
U = np.array(logs["U_k"])
popt = fit_damped_sinusoid(U)  # returns A, zeta, omega, phi, C
Q = 1/(2*zeta); converged = (Q&lt;3) and (np.abs(U[-5:].mean()-C)&lt;eps)
</span></span><span><span class="hljs-keyword">\end</span></span><span>{verbatim}

</span><span><span class="hljs-keyword">\subsection</span></span><span>*{D.7 Quality Control (QC) Checklist}
</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
</span><span><span class="hljs-keyword">\item</span></span><span> EEG/MEG: report channel dropouts; ICA components retained; percent trials kept; CFC surrogates passed.
</span><span><span class="hljs-keyword">\item</span></span><span> fMRI: framewise displacement </span><span><span class="hljs-built_in">$</span></span><span>&lt;</span><span><span class="hljs-built_in">$</span></span><span>0.3</span><span><span class="hljs-keyword">\,</span></span><span>mm median; tSNR per ROI; HMM/GC model order justified.
