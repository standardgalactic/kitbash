.icon-shimmer { animation: 5s cubic-bezier(0.2, 0.44, 0.38, 1.02) 0s infinite normal none running icon-shimmer; background-repeat: no-repeat; mask: linear-gradient(80deg, currentcolor 30%, rgba(0, 0, 0, 0.333), currentcolor 70%) 100% center / 300% 100%; }

@keyframes icon-shimmer { 
