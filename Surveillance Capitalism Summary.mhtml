><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.345em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mord"><span class="mord mathnormal">x</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height: 0.8913em;"><span style="top: -3.113em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right: 0.13889em;">T</span></span></span></span></span></span></span></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.13889em;">P</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3117em;"><span style="top: -2.55em; margin-left: -0.1389em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">i</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.8913em;"><span style="top: -2.453em; margin-left: -0.0359em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">i</span></span></span><span style="top: -3.113em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right: 0.13889em;">T</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.247em;"><span></span></span></span></span></span></span><span class="mord mathnormal">x</span><span class="mclose delimcenter" style="top: 0em;"><span class="delimsizing size1">)</span></span></span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord text"><span class="mord">slack&nbsp;for&nbsp;</span></span><span class="mord"><span class="mord mathnormal">x</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height: 0.8991em;"><span style="top: -3.113em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">d</span></span></span></span></span></span></span></span><span class="mord text"><span class="mord">&nbsp;terms</span></span><span class="mclose delimcenter" style="top: 0em;"><span class="delimsizing size4">}</span></span></span></span></span></span></span>
<p data-start="2783" data-end="3099" class=""><strong data-start="2783" data-end="2796">Overview:</strong><br data-start="2796" data-end="2799">
Highly nonlinear polynomial systems (common in recursive symbolic logic) are quadratized using relaxation techniques like sum-of-squares (SOS) or Lasserre hierarchies. This enables <strong data-start="2980" data-end="3014">tractable recursive evaluation</strong> in systems like SpherePop where symbolic expressions grow in depth and nonlinearity.</p>
<hr data-start="3101" data-end="3104" class="">
<h3 data-start="3106" data-end="3146" class=""><strong data-start="3110" data-end="3144">6. Non-convex Optimization QPR</strong></h3>
<p data-start="3147" data-end="3161" class=""><strong data-start="3147" data-end="3159">Formula:</strong></p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><munder><mrow><mi>min</mi><mo>‚Å°</mo></mrow><mrow><mi>x</mi><mo>‚àà</mo><msup><mi mathvariant="double-struck">R</mi><mi>n</mi></msup></mrow></munder><mrow><mo fence="true">{</mo><mstyle displaystyle="false" scriptlevel="0"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msup><mi>x</mi><mi>T</mi></msup><mi>P</mi><mi>x</mi><mo>+</mo><msup><mi>q</mi><mi>T</mi></msup><mi>x</mi><mo>+</mo><munder><mo>‚àë</mo><mi>k</mi></munder><msub><mi>œµ</mi><mi>k</mi></msub><mo fence="true">}</mo></mrow><mo separator="true">,</mo><mspace width="1em"></mspace><mtext>using&nbsp;convex&nbsp;outer&nbsp;bounds</mtext></mrow><annotation encoding="application/x-tex">\min_{x \in \mathbb{R}^n} \left\{ \tfrac{1}{2}x^T P x + q^T x + \sum_k \epsilon_k \right\}, \quad \text{using convex outer bounds}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 3.0521em; vertical-align: -1.3021em;"></span><span class="mop op-limits"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.6679em;"><span style="top: -2.3518em; margin-left: 0em;"><span class="pstrut" style="height: 3em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">x</span><span class="mrel mtight">‚àà</span><span class="mord mtight"><span class="mord mathbb mtight">R</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height: 0.5935em;"><span style="top: -2.786em; margin-right: 0.0714em;"><span class="pstrut" style="height: 2.5em;"></span><span class="sizing reset-size3 size1 mtight"><span class="mord mathnormal mtight">n</span></span></span></span></span></span></span></span></span></span></span><span style="top: -3em;"><span class="pstrut" style="height: 3em